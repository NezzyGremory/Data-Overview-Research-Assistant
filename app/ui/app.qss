/* ============================================================
   DATASET RESEARCH — MODERN BLUE / WHITE DESKTOP UI
   ============================================================ */

* {
    font-family: "Segoe UI";
}

QMainWindow,
#appRoot,
#pageStack,
#contentContainer {
    background: #F5F9FF;
    color: #172033;
}

QWidget {
    color: #172033;
}

/* ============================================================
   SIDEBAR
   ============================================================ */

#sidebar {
    border: none;
    background: #FFFFFF;
}

#brandLogo {
    /* Logo label — size set in Python */
}

#brandTitle {
    color: #172033;
    font-weight: 800;
    letter-spacing: @px(1.6);
}

#brandAccent {
    color: #4F8CFF;
    font-size: @px(18);
    font-weight: 800;
    letter-spacing: @px(1.6);
}

#brandSubtitle {
    color: #8899AF;
    font-weight: 600;
    letter-spacing: @px(0.4);
}

#sectionLabel {
    color: #8A98AB;
    font-size: @px(10);
    font-weight: 700;
    letter-spacing: @px(0.9);
}

#navButton {
    background: transparent;
    border: @px(1) solid transparent;
    border-radius: @px(8);
    text-align: left;
}

#navButton:hover {
    background: #F0F6FF;
    border-color: #E1ECFD;
}

#navButton[active="true"] {
    background: #E8F2FF;
    border: @px(1) solid #CFE3FF;
}

#navButton:disabled {
    background: transparent;
    border-color: transparent;
}

#navIcon {
    color: #4F8CFF;
    font-size: @px(15);
    font-weight: 700;
}

#navButton[active="true"] #navIcon {
    color: #2B6FD8;
}

#navText {
    color: #4D607A;
    font-size: @px(12);
    font-weight: 600;
}

#navButton[active="true"] #navText {
    color: #2B6FD8;
    font-weight: 700;
}

#workspaceStatus {
    padding: @px(6) @px(8);
    border-radius: @px(8);
}

#workspaceStatusTitle {
    color: #8A98AB;
    font-size: @px(10);
    font-weight: 700;
    letter-spacing: @px(1);
}

#workspaceStatusValue {
    color: #344158;
    font-size: @px(12);
    font-weight: 600;
}

#sidebarFooter {


    line-height: 1.45;
    padding: @px(4) @px(8) 0 @px(8);
}

/* ============================================================
   TOPBAR
   ============================================================ */

#topbar {
    background: #FFFFFF;
    border-bottom: @px(1) solid #EBF1FA;
}

#topbarTitle {
    color: #172033;
    font-size: @px(16);
    font-weight: 700;
}

#topbarStatus {


    border-radius: @px(14);

    font-size: @px(11);
    font-weight: 700;
    padding: @px(8) @px(12);
}

/* ============================================================
   COMMON PAGE TEXT
   ============================================================ */

#pageTitle {



    letter-spacing: -0.02em;
}

#pageSubtitle,
#pageDescription {


    line-height: 1.45;
}

#nodeEditorDatasetStatus {
    color: #2563A8;
    font-size: @px(11);
    font-weight: 700;
    padding: @px(4) @px(4);
}

#nodeEditorTaskStatus {
    background: #EAF4FF;
    border: @px(1) solid #C7DFF8;
    border-radius: @px(7);
    color: #245B8F;
    font-size: @px(11);
    font-weight: 700;
    padding: @px(4) @px(12);
}

#nodeEditorRunStatus {
    color: #526579;
    font-size: @px(11);
}

#nodeEditorRunSpinner {
    color: #0878D1;
    font-weight: 700;
}

#nodeEditorCanvas {
    background: #F1F7FF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(12);
}

QSplitter#nodeEditorSplitter::handle {
    background: #E8EFF8;
    width: @px(4);
}

QSplitter#nodeEditorSplitter::handle:hover {
    background: #9BC6F3;
}

#nodeEditorZoomControls {
    background: #FFFFFF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(9);
}

#nodeEditorZoomControls QPushButton {
    background: #F7FAFE;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(7);
    color: #245B8F;
    font-size: @px(16);
    font-weight: 700;
    padding: 0;
}

#nodeEditorZoomControls QPushButton:hover:!disabled {
    background: #EDF6FF;
    border-color: #AFCFF2;
}

#nodeEditorZoomControls QLabel {
    color: #526579;
    font-size: @px(11);
    font-weight: 700;
}

QSplitter#nodeEditorWorkspaceSplitter::handle {
    background: #E8EFF8;
    height: @px(8);
}
QSplitter#nodeEditorWorkspaceSplitter::handle:hover {
    background: #9BC6F3;
}
#nodeEditorHelp {
    background: #F7FAFE;
    border: @px(1) solid #E3ECF7;
    border-radius: @px(8);
    color: #526579;
    font-size: @px(11);
    padding: @px(12);
}
#nodeEditorPreviewCombo {
    min-height: @px(32);
}
#nodeEditorTemplateCombo,
#nodeEditorWorkflowFilter,
#nodeEditorMetricModel,
#nodeEditorDatasetScope {
    min-height: @px(32);
}
#nodeEditorMetricCard {
    background: #F7FAFE;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(8);
}
#nodeEditorMetricLabel {
    color: #64748B;
    font-size: @px(11);
    font-weight: 600;
}
#nodeEditorMetricValue {
    color: #145B9B;
    font-size: @px(17);
    font-weight: 700;
}
#nodeEditorSectionTitle {
    color: #26364A;
    font-size: @px(12);
    font-weight: 700;
}
#nodeEditorEmptyState {
    color: #64748B;
    padding: @px(8);
}
#nodeEditorTable {
    background: #FFFFFF;
    alternate-background-color: #F7FAFE;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(8);
    color: #26364A;
    gridline-color: #E8EEF6;
    selection-background-color: #DCEAFF;
    selection-color: #172033;
}
#nodeEditorTable::item { padding: @px(4) @px(8); }
#nodeEditorTable QHeaderView::section {
    background: #F1F6FC;
    border: none;
    border-bottom: @px(1) solid #DCE8F7;
    border-right: @px(1) solid #E5ECF5;
    color: #42546B;
    font-size: @px(11);
    font-weight: 600;
    padding: @px(8) @px(8);
}
#nodeEditorProblems {
    background: #FFFFFF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(8);
    padding: @px(4);
}
#nodeEditorProblems::item { padding: @px(8) @px(8); }

#sectionTitle {

    
    font-weight: 700;
    letter-spacing: -0.01em;
}

#sectionDescription {
    color: #8A98AB;
    font-size: @px(11);
}

/* ============================================================
   CARDS
   ============================================================ */

#contentCard,
#statCard,
#currentDatasetCard,
#quickActionCard,
#metricCard,
#researchCard,
#uploadCard,
#pipelineCard,
#pipelineStageCard,
#heroCard,
#heroVisual,
#researchStatus {
    background: #FFFFFF;

    border-radius: @px(14);
}

#contentCard:hover,
#quickActionCard:hover,
#currentDatasetCard:hover {
    border-color: #C8DBF7;
}

#statCard {
    min-height: @px(72);
}

#statTitle,
#metricTitle {
    color: #7D8CA0;
    font-size: @px(11);
    font-weight: 700;
    letter-spacing: @px(0.8);
}

#statValue,
#metricValue {
    color: #172033;
    font-size: @px(19);
    font-weight: 750;
}

#statDescription {
    color: #98a2b1;
    font-size: @px(11);
}

#cardTitle {
    color: #1B2A41;
    font-size: @px(15);
    font-weight: 700;
}

#cardLabel {
    color: #59677d;
    font-size: @px(11);
    font-weight: 700;
}

#cardDescription,
#analysisContent {
    color: #6f7c90;
    font-size: @px(12);
    line-height: 1.5;
}

#dropMissingWarningBanner {
    background: #FFF0EE;
    border: @px(1) solid #E7A39B;
    border-radius: @px(6);
    color: #8E2920;
    padding: @px(8) @px(12);
    font-weight: 650;
}

#analysisActiveDatasetLabel {
    color: #28734D;
    font-weight: 700;
}

#mlReadinessStatusBadge {
    border: @px(1) solid transparent;
    border-radius: @px(10);
    font-size: @px(11);
    font-weight: 700;
    padding: @px(4) @px(12);
}

#mlReadinessStatusBadge[state="ok"] {
    background: #EAF7F0;
    border-color: #D3EFDF;
    color: #2C9B68;
}

#mlReadinessStatusBadge[state="warning"] {
    background: #FFF8EB;
    border-color: #F5DDA6;
    color: #C27D1A;
}

#mlReadinessStatusBadge[state="issue"] {
    background: #FFF0F0;
    border-color: #F5CACA;
    color: #C23030;
}

#analysisQualityInsight {
    border: @px(1) solid #DCE8F7;
    border-radius: @px(8);
}

#analysisQualityInsight[state="ok"] {
    background: #F0FBF5;
    border-color: #CDEEDB;
}

#analysisQualityInsight[state="warning"] {
    background: #FFFAEE;
    border-color: #F3E0AC;
}

#analysisQualityInsight[state="issue"] {
    background: #FFF3F2;
    border-color: #F2D0CD;
}

#analysisQualityInsightTitle {
    color: #26364B;
    font-size: @px(12);
    font-weight: 700;
}

#analysisQualityInsightValue {
    color: #26364B;
    font-size: @px(12);
    font-weight: 700;
}

#analysisQualityInsightDescription {
    color: #64758B;
    font-size: @px(11);
}

#sidebarToggleButton {
    min-width: @px(36);
    min-height: @px(36);
    border: @px(1) solid #DCE8F7;
    border-radius: @px(8);
    background: #FFFFFF;
    color: #2563A6;
    font-size: @px(16);
}

#sidebarToggleButton:hover {
    background: #EEF5FF;
}

/* ============================================================
   DASHBOARD HERO
   ============================================================ */

#heroCard {
    border-radius: @px(18);
}

#heroEyebrow {
    color: #8899AF;
    font-size: @px(11);
    font-weight: 600;
}

#heroTitle {
    color: #172033;
    font-weight: 750;
    letter-spacing: -0.03em;
}

#heroDescription {
    color: #66768C;
    line-height: 1.45;
}

#heroButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4F8CFF, stop:1 #3E77EA);
    border: @px(1) solid #3E77EA;
    border-radius: @px(10);
    color: #FFFFFF;
    font-size: @px(11);
    font-weight: 700;
    padding: 0 @px(16);
}

#heroButton:hover {
    background: #3e7eea;
    border-color: #3e7eea;
}

#heroButton:pressed {
    background: #326fd4;
}

#heroVisual {
    background: #EEF5FF;
    border-color: #dce7f6;
}

#heroVisualTitle {
    color: #2A4E7D;
    font-size: @px(11);
    font-weight: 700;
    letter-spacing: @px(1);
}

#heroWorkflowNumber {
    color: #4F8CFF;
    font-size: @px(11);
    font-weight: 800;
}

#heroWorkflowTitle {
    color: #52657D;
    font-size: @px(11);
    font-weight: 600;
}

/* ============================================================
   QUICK ACTIONS
   ============================================================ */

#quickActionCard {
    background: #FFFFFF;
}

#quickActionCard:hover {
    background: #F7FBFF;
    border-color: #C8DCF7;
}

#quickActionIcon {
    color: #4F8CFF;
    font-size: @px(16);
    font-weight: 700;
}

#quickActionTitle {
    color: #1B2A41;
    font-size: @px(13);
    font-weight: 700;
}

#quickActionDescription {
    color: #6F7C90;
    font-size: @px(12);
    line-height: 1.35;
}

#quickActionButton {
    background: transparent;
    border: none;

    font-size: @px(11);
    font-weight: 700;

    text-align: left;
}

#quickActionButton:hover {
    color: #2B6FD8;
}

/* ============================================================
   DATASET STATUS / PIPELINE
   ============================================================ */

#datasetName {
    color: #172033;
    font-size: @px(14);
    font-weight: 700;
}

#datasetDescription {
    color: #7A899C;
    font-size: @px(12);
}

#datasetStatusBadge,
#scoreBadge {
    border: @px(1) solid #D3EFDF;
    border-radius: @px(10);
    font-size: @px(11);
    font-weight: 700;
    padding: @px(3) @px(8);
}

#datasetStatusBadge[state="success"] {
    background: #EAF7F0;
    border-color: #D3EFDF;
    color: #2C9B68;
}

#datasetStatusBadge[state="active"] {
    background: #eef5ff;
    border-color: #d9e7fb;
    color: #3d78cc;
}

#pipelineCard {
    padding: @px(8) @px(14);
}

#pipelineStageCard {
    padding: @px(10) @px(14);
}

#pipelineStageCard[state="success"] {
    background: #f4fbf7;
    border-color: #cfeadb;
}

#pipelineStageCard[state="active"] {
    background: #f3f7ff;
    border-color: #cfe0fb;
}

#pipelineStageCard[state="future"] {
    background: #f8f9fb;
    border-color: #e7eaf0;
}

#pipelineNumber {
    color: #4F8CFF;
    font-size: @px(11);
    font-weight: 800;
}

#pipelineTitle {
    color: #344158;
    font-size: @px(12);
    font-weight: 700;
}

#pipelineStatus {
    color: #8A98AB;
    font-size: @px(11);
}

#pipelineStatus[state="success"] {
    color: #35A86F;
}

#pipelineStatus[state="active"] {
    color: #3577E5;
}

#pipelineStatus[state="future"] {
    color: #a0a8b5;
}

#pipelineConnector {
    color: #b4becd;
    font-size: @px(16);
}

/* ============================================================
   BUTTONS
   ============================================================ */

#primaryButton {
    background: #4f8cff;
    border: @px(1) solid #4f8cff;
    border-radius: @px(8);
    color: #FFFFFF;
    font-size: @px(11);
    font-weight: 700;
    padding: 0 @px(16);
}

#primaryButton:hover {
    background: #3e7eea;
    border-color: #3e7eea;
}

#primaryButton:pressed {
    background: #326fd4;
}

#primaryButton:disabled {
    background: #EEF2F7;
    border-color: #C9D3E0;
    color: #5A6675;
}

QPushButton {
    outline: none;
}

QPushButton:hover:!disabled {
    border-color: #AFC8EF;
}

QPushButton:pressed:!disabled {
    background-color: #EAF1FF;
    border-color: #91B4EB;
}

QPushButton:focus:!disabled {
    border-color: #8DB5F8;
}

/* ============================================================
   UPLOAD
   ============================================================ */

#uploadCard {
    padding: @px(24);
}

#uploadIcon {
    color: #4D88F8;
    font-size: @px(11);
    font-weight: 800;
    letter-spacing: @px(1.2);
}

/* ============================================================
   ANALYSIS / ML / RESEARCH
   ============================================================ */

#emptyState,
#errorState {
    background: #FFFFFF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(12);
    color: #778397;
    font-size: @px(12);
    padding: @px(32);
}

#errorState {
    background: #fff8f8;
    border-color: #f0d9d9;
    color: #a35f5f;
}

#statusLabel {
    color: #64748B;
    font-size: @px(12);
}

#researchStatus {
    background: #F7FBFF;
    border-color: #DCEAF8;
}

#metricCard {
    background: #FFFFFF;
}

#researchCard {
    background: #FFFFFF;
}

/* ============================================================
   TABLES / LISTS / TEXT AREAS
   ============================================================

QTableWidget,
QListWidget,
QTextEdit,
QTextBrowser {
    background: #FFFFFF;
    border: @px(1) solid #e1e7ef;
    border-radius: @px(9);
    color: #344158;
    selection-background-color: #edf4ff;
    selection-color: #1d2b42;
}

QTableWidget {
    gridline-color: #edf0f5;
}

QHeaderView::section {
    background: #F3F7FC;
    border: none;
    border-bottom: @px(1) solid #E0EAF5;
    color: #58697C;
    font-size: @px(11);
    font-weight: 700;
    padding: @px(6) @px(10);
}

QListWidget::item {
    padding: @px(8);
    border-radius: @px(6);
}

QListWidget::item:hover {
    background: #f5f8fc;
}

QListWidget::item:selected {
    background: #edf4ff;
    color: #245baf;
}

QTextEdit {
    padding: @px(8);
}

/* ============================================================
   TABS
   ============================================================ */

QTabWidget::pane {
    border: none;
    top: @px(-1);
}

QTabBar::tab {
    background: transparent;
    border: none;

    font-size: @px(11);
    font-weight: 600;

}

QTabBar::tab:hover {
    color: #2B5FD4;
}

QTabBar::tab:selected {
    color: #2455C5;
    border-bottom: @px(2) solid #4F8CFF;
    font-weight: 700;
}

/* ============================================================
   INPUTS / COMBOBOX / CHECKBOX
   ============================================================ */

QLineEdit,
QComboBox {
    background: #FFFFFF;
    border: @px(1) solid #dce3ed;
    border-radius: @px(7);
    color: #344158;
    min-height: @px(32);
    padding: 0 @px(8);
}

QLineEdit:focus,
QComboBox:focus {
    border-color: #86adf0;
}

QComboBox::drop-down {
    border: none;
    width: @px(28);
}

QCheckBox {
    color: #66748a;
    spacing: @px(8);
}

/* ============================================================
   PROGRESS BAR
   ============================================================ */

QProgressBar {

    border: none;
    border-radius: @px(4);
    max-height: @px(8);
    text-align: center;
}

QProgressBar::chunk {

    border-radius: @px(4);
}

#navigationLoadingProgress {
    background: transparent;
    border: none;
    border-radius: 0;
    max-height: @px(8);
}

#navigationLoadingProgress::chunk {
    background: #006bb8;
    border-radius: 0;
}

/* ============================================================
   SCROLLBARS
   ============================================================ */

QScrollBar:vertical {
    background: transparent;
    

}

QScrollBar::handle:vertical {
    background: #C5D5E8;
    border-radius: @px(4);
    min-height: @px(32);
}

QScrollBar::handle:vertical:hover {
    background: #A8BEDE;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: @px(8);
    margin: @px(4);
}

QScrollBar::handle:horizontal {
    background: #C5D5E8;
    border-radius: @px(4);
    min-width: @px(32);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
    width: 0;
}

/* ============================================================
   TOOLTIP / DIVIDERS
   ============================================================ */

QToolTip {
    background: #172033;
    border: @px(1) solid #27344a;
    color: #FFFFFF;
    padding: @px(4) @px(8);
}

QFrame[frameShape="4"] {
    color: #e5e9ef;
}

/* ============================================================
   POLISHED UI OVERRIDES — LIGHT BLUE EDITION
   ============================================================ */

QMainWindow {
    background: #F5F9FF;
}

QWidget {
    selection-background-color: #DCEEFF;
    selection-color: #172033;
}

#sidebar {
    background: #FFFFFF;
    border-right: @px(1) solid #E1ECF8;
}

#brandLogo {


    border-radius: @px(12);

}

#brandTitle { color: #172033; }
#brandAccent { color: #4F8CFF; }
/* #brandSubtitle and #sectionLabel already defined above */

#navButton {
    border-radius: @px(8);
    padding-left: @px(4);
}

#navButton:hover {
    background: #F0F6FF;
    border-color: #E0EDFB;
}

#navButton[active="true"] {
    background: #E8F2FF;
}

#navText { font-weight: 600; }
#navButton[active="true"] #navText { color: #2B6FD8; font-weight: 700; }
#navIcon { color: #4F8CFF; }
#navButton[active="true"] #navIcon { color: #4F8CFF; }

#workspaceStatus {
    border: @px(1) solid #DFEBF8;
    border-radius: @px(8);
    padding: @px(6) @px(8);
}

#workspaceStatusTitle { color: #8A98AB; font-size: @px(10); font-weight: 700; letter-spacing: @px(1); }
#workspaceStatusValue { color: #344158; font-size: @px(12); font-weight: 600; }
#sidebarFooter { color: #8A98AB; font-size: @px(10); }

#topbar {
    background: #FFFFFF;
    border-bottom: @px(1) solid #EBF1FA;
}

#topbarTitle { color: #172033; font-size: @px(16); font-weight: 700; }
#topbarStatus {
    background: #F0F7FF;
    border: @px(1) solid #D8E9FC;
    color: #3979D9;
}

#contentContainer, #pageStack, #appRoot { background: #F5F9FF; }

#pageTitle { color: #172033; font-size: @px(25); font-weight: 750; }
#pageSubtitle, #pageDescription { color: #718096; font-size: @px(13); }
#sectionTitle { color: #1C2B40; font-weight: 700; }
#sectionDescription { color: #8190A4; }

#contentCard, #statCard, #currentDatasetCard, #quickActionCard,
#metricCard, #researchCard, #uploadCard, #pipelineCard,
#pipelineStageCard, #heroCard, #heroVisual, #researchStatus {
    background: #FFFFFF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(14);
}

#contentCard:hover, #quickActionCard:hover, #researchCard:hover,
#currentDatasetCard:hover, #statCard:hover {
    border-color: #C8DDF5;
}

#heroCard {
    background: #FFFFFF;
    border: @px(1) solid #D6E7FA;
}

#heroVisual {
    background: #F0F7FF;
    border: @px(1) solid #D9EAFE;
}

#heroTitle { color: #172033; font-weight: 750; }
#heroDescription { color: #66768C; }

#heroVisualTitle { color: #2A4E7D; font-weight: 700; }
#heroWorkflowNumber { color: #4F8CFF; font-weight: 800; }
#heroWorkflowTitle { color: #52657D; font-weight: 600; }

#primaryButton, #analyzeButton, #runButton, #uploadButton {
    background: #4F8CFF;
    color: #FFFFFF;
    border: @px(1) solid #4F8CFF;
    border-radius: @px(9);
    min-height: @px(40);
    padding: 0 @px(16);
    font-weight: 700;
}

#primaryButton:hover, #analyzeButton:hover, #runButton:hover, #uploadButton:hover {
    background: #3E7EF0;
    border-color: #3E7EF0;
}

#primaryButton:pressed, #analyzeButton:pressed, #runButton:pressed, #uploadButton:pressed {
    background: #3473E1;
}

#primaryButton:disabled, #analyzeButton:disabled, #runButton:disabled, #uploadButton:disabled {
    background: #EEF2F7;
    border-color: #C9D3E0;
    color: #5A6675;
}

#secondaryButton {
    background: #FFFFFF;
    color: #3577E5;
    border: @px(1) solid #CFE3FF;
    border-radius: @px(8);
    min-height: @px(32);
    padding: 0 @px(16);
    font-size: @px(11);
    font-weight: 600;
}

#secondaryButton:hover {
    background: #F1F7FF;
    border-color: #B8D6FF;
    color: #245BAF;
}

#secondaryButton:pressed {
    background: #E5F1FF;
}

#secondaryButton:disabled {
    background: #EEF2F7;
    border-color: #C9D3E0;
    color: #5A6675;
}

#quickActionButton {
    background: transparent;
    border: none;

    font-weight: 700;
    text-align: left;
    padding: @px(4) 0;
}
#quickActionButton:hover { color: #286CD7; }
#quickActionIcon { color: #4F8CFF; }
#quickActionTitle { color: #1B2A41; font-weight: 700; }
#quickActionDescription { color: #6F7C90; font-size: @px(12); }

#statTitle, #cardLabel, #metricTitle { color: #8492A5; font-size: @px(11); font-weight: 700; }
#statValue, #cardValue, #metricValue { color: #172033; font-size: @px(22); font-weight: 750; }
#statDescription, #cardDescription { color: #8A98AA; font-size: @px(11); }

#datasetName { font-weight: 700; }
#datasetDescription { font-size: @px(12); }
#datasetStatusBadge, #scoreBadge {
    background: #EAF7F0;
    border: @px(1) solid #D3EFDF;
    color: #2C9B68;
    border-radius: @px(10);
    padding: @px(4) @px(8);
    font-size: @px(11);
    font-weight: 700;
}

#pipelineCard { padding: @px(8); }
#pipelineTitle { color: #344158; font-weight: 700; }
#pipelineNumber { color: #4F8CFF; font-weight: 800; }
#pipelineStatus { font-size: @px(11); }
#pipelineStatus[state="completed"] { color: #35A86F; }
#pipelineStatus[state="active"] { color: #3577E5; }
#pipelineStatus[state="error"] { color: #E46666; }
#pipelineConnector { background: #D8E7F8; max-height: @px(4); }

#uploadCard {
    background: #FFFFFF;
    border: @px(1) dashed #BFD9F5;
    min-height: @px(232);
}
#uploadCard:hover { background: #F8FBFF; border-color: #4F8CFF; }
#uploadIcon { color: #4D88F8; background: #EDF6FF; border-radius: @px(14); }
#uploadTitle { color: #20324A; font-size: @px(18); font-weight: 700; }
#uploadDescription { color: #7A899C; font-size: @px(12); }

QLineEdit, QComboBox, QSpinBox, QTextEdit, QPlainTextEdit {
    background: #FFFFFF;
    border: @px(1) solid #D8E5F3;
    border-radius: @px(9);
    padding: @px(8) @px(12);
    color: #25364D;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #8CB9F0;
}

QTableWidget, QTableView {
    background: #FFFFFF;
    alternate-background-color: #F8FBFF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(10);
    gridline-color: #E8EFF7;
}
QHeaderView::section {


    border: none;



}

QTabWidget::pane {
    border: none;
    top: @px(-1);
}
QTabBar::tab {
    background: transparent;


    margin-right: @px(4);
    border: none;
    border-bottom: @px(2) solid transparent;
}
QTabBar::tab:hover { color: #2B5FD4; }
QTabBar::tab:selected {
    color: #2455C5;
    border-bottom: @px(2) solid #4F8CFF;
    font-weight: 700;
}

QScrollArea { border: none; }
QScrollBar:vertical { background: transparent; }
QScrollBar::handle:vertical { background: #C5D5E8; border-radius: @px(4); min-height: @px(32); }
QScrollBar::handle:vertical:hover { background: #AFC7E2; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: @px(8); }
QScrollBar::handle:horizontal { background: #C9D9EB; border-radius: @px(4); }

#analysisContent, #emptyState, #errorState {
    background: transparent;
}

#statusLabel { color: #64748B; font-size: @px(12); }
#researchStatus { background: #F7FBFF; border-color: #DCEAF8; }
#researchStatus QLabel { color: #65768C; }

#researchCard { padding: @px(4); }
#researchCard QLabel { color: #53667D; }

/* Keep long research text readable instead of visually collapsing it. */
QTextEdit, QTextBrowser, QPlainTextEdit {
    font-size: @px(12);
    line-height: 1.45;
}

QProgressBar {
    background: #EAF2FB;
    border: none;
    border-radius: @px(4);
    text-align: center;
    height: @px(8);
}
QProgressBar::chunk {
    background: #4F8CFF;
    border-radius: @px(4);
}


/* ============================================================
   DASHBOARD POLISH — HERO / TEXT SPACING
   ============================================================ */

#heroTitle {
    font-size: @px(24);
    line-height: 1.15;
    padding: 0;
    margin: 0;
}

#heroDescription {
    font-size: @px(12);
    line-height: 1.45;
    padding: 0;
    margin: 0;
}

#heroButton {
    min-height: @px(36);
    max-height: @px(36);
}

#sectionTitle {
    font-size: @px(15);
}

#sectionDescription {
    font-size: @px(11);
}

#quickActionCard {
    padding: @px(4);
}

#quickActionTitle {
    color: #1B2A41;
    font-size: @px(13);
    font-weight: 700;
}

#quickActionDescription {
    color: #6F7C90;
    font-size: @px(12);
    line-height: 1.35;
}

/* ============================================================
   DASHBOARD CLEAN / COMPACT
   ============================================================ */
#heroCard {
    min-height: @px(196);
}
#heroTitle {
    font-size: @px(24);
    line-height: 1.15;
}
#heroDescription {
    font-size: @px(12);
    line-height: 1.45;
}
#heroVisual {
    border-radius: @px(13);
}
#heroWorkflowTitle {
    font-size: @px(11);
}
#heroWorkflowNumber {
    font-size: @px(11);
}
#sectionTitle {
    font-size: @px(15);
}
#quickActionCard #quickActionDescription {

    line-height: 1.4;
}
#quickActionCard #quickActionTitle {
    color: #1B2A41;
    font-size: @px(13);
    font-weight: 700;
}
#quickActionCard #quickActionButton {
    font-size: @px(11);
}
#currentDatasetCard {
    min-height: @px(88);
}
#statCard {
    min-height: @px(72);
}
#pipelineCard {
    min-height: @px(84);
}
#pipelineStageCard {
    padding: @px(10) @px(14);
}
#pipelineTitle {
    color: #344158;
    font-size: @px(13);
    font-weight: 700;
}
#pipelineStatus {
    font-size: @px(11);
}


/* Research Tools: active blue navigation style. */
#navButton[toolItem="true"] #navIcon {
    color: #4F8CFF;
    font-size: @px(15);
    font-weight: 700;
}
#navButton[toolItem="true"] #navText {
    color: #3577E5;
    font-size: @px(12);
    font-weight: 650;
}
#navButton[toolItem="true"]:hover {
    background: #EEF5FF;
    border-color: #CFE3FF;
}
#navButton[toolItem="true"][active="true"] {
    background: #E5F1FF;
    border-color: #CFE3FF;
}
#navButton[toolItem="true"][active="true"] #navIcon,
#navButton[toolItem="true"][active="true"] #navText {
    color: #2F6FD8;
}

/* Dashboard research snapshot charts. */
#dashboardChartCard {
    background: #FFFFFF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(14);
}
#dashboardChartCard:hover {
    border-color: #C7DCF6;
}
#dashboardScroll {
    background: transparent;
}

#datasetsTabs {
    background: transparent;
}
#datasetsTabs::pane {
    background: #FFFFFF;
    border: @px(1) solid #DCE8F7;
    border-radius: 0 0 @px(14) @px(14);
    top: @px(-1);
}
#datasetsTabs QTabBar::tab {
    background: #F3F7FC;
    border: @px(1) solid #E2EAF4;
    border-bottom: none;
    border-radius: @px(9) @px(9) 0 0;
    color: #5D6C80;
    min-width: @px(152);
    padding: @px(12) @px(16);
}
#datasetsTabs QTabBar::tab:selected {
    background: #FFFFFF;
    border-color: #DCE8F7;
    color: #2865B8;
}


/* Progress feedback for long-running analysis and model training. */
#mlRunOptionsPanel {
    background: #FFFFFF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(12);
}
#mlRunOptionsPanel QComboBox,
#mlRunOptionsPanel QSpinBox {
    min-height: @px(34);
}
#mlRunOptionsPanel QTabWidget::pane {
    background: #FFFFFF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(8);
}
#mlRunOptionsPanel QListWidget {
    background: #FAFCFF;
    border: @px(1) solid #E3ECF7;
    border-radius: @px(7);
}

#loadingSpinner {
    color: #3478E5;
    font-size: @px(23);
    font-weight: 700;
}
#loadingProgress {
    background: #E8F0FC;
    border: none;
    border-radius: @px(3);
}
#loadingProgress::chunk {
    background: #4F8CFF;
    border-radius: @px(3);
}

#gapExplanationBody {
    background: #F9FBFE;
    border: @px(1) solid #E2EAF4;
    border-radius: @px(8);
    color: #344158;
    padding: @px(12);
}

#gapExplanationEyebrow {
    color: #2360B5;
    font-size: @px(11);
    font-weight: 700;
    letter-spacing: @px(0.7);
}

#researchGapEvidence {
    background: #F5F8FD;
    border: @px(1) solid #E3EAF4;
    border-radius: @px(8);
    color: #4B5D77;
    padding: @px(9) @px(11);
}

QFrame#contentCard[researchGapExplanation="true"] {
    border-left: @px(4) solid #1769E8;
}

/* Dashboard arrangement follows the provided reference image. */
#dashboardCanvas {
    background: #F3F6FC;
    font-family: "Segoe UI";
    font-size: @px(12);
}

#dashboardHero {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #2448D6, stop:1 #326CFA);
    border: none;
    border-radius: @px(20);
}

#heroEyebrow { color: #E8EEFF; font-size: @px(11); font-weight: 600; letter-spacing: @px(0.4); }
#datasetName { color: #FFFFFF; font-size: @px(24); font-weight: 700; }
#datasetDescription { color: #E3EAFF; font-size: @px(12); }

#datasetStatusBadge {
    background: rgba(255,255,255,0.16);
    border: @px(1) solid rgba(255,255,255,0.2);
    border-radius: @px(12);
    color: #FFFFFF;
    font-size: @px(11);
    font-weight: 600;
    padding: @px(4) @px(8);
}

#datasetStatusBadge[state="success"] {
    background: rgba(17,184,166,0.2);
    border-color: rgba(181,255,243,0.4);
    color: #FFFFFF;
}

#dashboardHero #datasetStatusBadge[state="success"] {
    background: rgba(17,184,166,0.2);
    border-color: rgba(181,255,243,0.4);
    color: #FFFFFF;
}

#heroMetricCard {
    background: rgba(255,255,255,0.15);
    border: @px(1) solid rgba(255,255,255,0.08);
    border-radius: @px(14);
}

#heroMetricCard #statTitle { color: #E1E9FF; }
#heroMetricCard #statValue { color: #FFFFFF; font-size: @px(25); font-weight: 700; }
#heroMetricCard #statDescription { color: #E1E9FF; font-size: @px(11); }

#dashboardCanvas #sectionTitle { color: #172541; font-size: @px(16); font-weight: 650; }
#dashboardCanvas #sectionDescription { color: #687A96; font-size: @px(12); }

#heroPrimaryButton,
#heroSecondaryButton {
    border-radius: @px(9);
    font-family: "Segoe UI";
    font-size: @px(12);
    font-weight: 600;
    padding: 0 @px(16);
}
#heroPrimaryButton {
    background: #FFFFFF;
    border: @px(1) solid #FFFFFF;
    color: #2858DF;
}
#heroPrimaryButton:hover { background: #EEF3FF; }
#heroPrimaryButton:disabled { color: #8B9AC0; }
#heroSecondaryButton {
    background: rgba(255,255,255,0.16);
    border: @px(1) solid rgba(255,255,255,0.22);
    color: #FFFFFF;
}
#heroSecondaryButton:hover { background: rgba(255,255,255,0.24); }

#quickActionCard {
    min-height: @px(96);
    background: #FFFFFF;
    border: @px(1) solid #DCE6F3;
    border-radius: @px(14);
}
#quickActionCard:hover { border-color: #B8CCF3; background: #FCFDFF; }

#quickActionIcon {
    background: #EAF0FF;
    border: none;
    border-radius: @px(10);
    color: #3267F6;
}

#quickActionTitle { color: #172541; font-size: @px(14); font-weight: 650; }
#quickActionCard #quickActionTitle { color: #172541; font-size: @px(14); font-weight: 650; }
#quickActionDescription { color: #687A96; font-size: @px(12); }
#quickActionCard #quickActionDescription { color: #687A96; font-size: @px(12); }
#quickActionButton { color: #2858DF; }
#dashboardCanvas #quickActionButton { font-family: "Segoe UI"; font-size: @px(12); font-weight: 600; }

#pipelineCard {
    background: #FFFFFF;
    border: @px(1) solid #E0E7F1;
    border-radius: @px(15);
}

#pipelineStageCard {
    background: transparent;
    border: none;
    border-radius: @px(10);
    min-height: @px(92);
}

#pipelineMarker {
    background: #E8ECF4;
    border: none;
    border-radius: @px(14);
    color: #75829A;
    font-size: @px(12);
    font-weight: 650;
}

#pipelineMarker[state="active"] { background: #3267F6; color: #FFFFFF; }
#pipelineMarker[state="success"] { background: #10A494; color: #FFFFFF; }
#pipelineTitle { color: #172541; font-size: @px(12); font-weight: 650; }
#pipelineStatus { color: #8290A7; font-size: @px(11); font-weight: 600; letter-spacing: 0; }
#pipelineStatus[state="success"] { color: #0BA895; }
#pipelineStatus[state="active"] { color: #3267F6; }
#workflowConnector { background: #DDE4EF; border: none; }
#workflowConnector[state="complete"] { background: #12B8A6; }

#dashboardChartCard {
    min-height: @px(204);
    background: #FFFFFF;
    border: @px(1) solid #DCE6F3;
    border-radius: @px(15);
}

/* About page */
#aboutPageTitle { color: #172033; font-size: @px(24); font-weight: 700; }
#aboutPageSubtitle { color: #718096; font-size: @px(12); }
#aboutHero {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #2448D6, stop:1 #326CFA);
    border: none;
    border-radius: @px(16);
}
#aboutLogo { background: #FFFFFF; border-radius: @px(12); }
#aboutHeroTitle { color: #FFFFFF; font-size: @px(22); font-weight: 700; }
#aboutHero #aboutBody { color: #E3EAFF; font-size: @px(12); }
#aboutVersion { color: #E3EAFF; font-size: @px(11); }
#aboutInfoCard {
    background: #FFFFFF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(13);
    min-height: @px(152);
}
#aboutCardTitle { color: #20324A; font-size: @px(14); font-weight: 650; }
#aboutBody { color: #63748A; font-size: @px(12); line-height: 1.5; }

/* Dataset readiness summary */
#readinessCard {
    background: #FFFFFF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(13);
}
#readinessTitle { color: #26364B; font-size: @px(14); font-weight: 700; }
#readinessStatus {
    background: #EEF4FC;
    border: @px(1) solid #DDE8F5;

    color: #63748A;
    font-size: @px(11);
    font-weight: 600;

}
#readinessStatus[state="success"] {
    background: #EAF7F0;
    border-color: #D3EFDF;
    color: #25805A;
}
#readinessStatus[state="attention"] {
    background: #FFF7E8;
    border-color: #F4E1B9;
    color: #93620B;
}
#readinessStatus[state="error"] {
    background: #FFF0F0;
    border-color: #F4D5D5;
    color: #A64242;
}
#readinessStatus[state="active"] {
    background: #EEF4FF;
    border-color: #D8E4FF;
    color: #3267C8;
}
#readinessMetric {
    padding: @px(6) @px(10);
    border-radius: @px(8);
}
#readinessMetricValue { color: #172033; font-size: @px(16); font-weight: 750; }
#readinessMetricLabel { color: #8190A4; font-size: @px(11); }
#readinessRecommendation { color: #64748B; font-size: @px(11); }

/* Full, read-only spreadsheet view for the active local dataset. */
#datasetPreviewHeader {
    padding: @px(4) @px(12);
    background: #F3F7FC;
    border-bottom: @px(1) solid #DCE8F7;
}
#datasetPreviewTable {
    background: #FFFFFF;
    alternate-background-color: #F7FAFE;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(10);
    color: #26364A;
    gridline-color: #E8EEF6;
    selection-background-color: #DCEAFF;
    selection-color: #172033;
}
#datasetPreviewTable::item { padding: @px(4) @px(8); }
#datasetPreviewTable QHeaderView::section {
    background: #F1F6FC;
    border: none;
    border-bottom: @px(1) solid #DCE8F7;
    border-right: @px(1) solid #E5ECF5;
    color: #42546B;
    font-size: @px(11);
    font-weight: 600;
    padding: @px(8) @px(8);
}

/* SINTA screening controls inside Academic Research / Ranked Papers. */
#paperScreeningToolbar {
    background: #FFFFFF;
    border: @px(1) solid #DCE6F3;
    border-radius: @px(10);
}
#paperSelectionPanel {
    background: #FFFFFF;
    border: @px(1) solid #DCE6F3;
    border-radius: @px(10);
}
#paperDetail {
    background: transparent;
    border: none;
    color: #25364D;
}
#sintaScreeningPanel {
    background: #F7F9FC;
    border: @px(1) solid #E3EAF3;
    border-radius: @px(8);
}
#sintaScreeningPanel #sectionTitle {
    color: #20324A;
    font-size: @px(14);
    font-weight: 650;
}
#sintaScreeningPanel #cardDescription {
    color: #687A96;
    font-size: @px(11);
}
#sintaPeriodConfirmed {
    color: #42546B;
    font-size: @px(11);
    spacing: @px(8);
}
#rankedPapersTable {
    background: #FFFFFF;
    border: @px(1) solid #DCE6F3;
    border-radius: @px(8);
    font-size: 9.5pt;
    gridline-color: #E7EDF5;
    alternate-background-color: #F8FAFD;
    selection-background-color: #DCEAFF;
    selection-color: #183B68;
}
#rankedPapersTable::item {
    padding: @px(4) @px(8);
    color: #25364D;
    border-bottom: @px(1) solid #EEF2F7;
}
#rankedPapersTable::item:selected {
    background: #DCEAFF;
    color: #183B68;
}
#rankedPapersTable QHeaderView::section {
    background: #F1F6FC;
    border: none;
    border-bottom: @px(1) solid #DCE6F3;
    color: #42546B;
    font-size: 9pt;
    font-weight: 600;
    min-height: @px(32);
    padding: @px(4) @px(8);
}
#rankedPapersTable QTableCornerButton::section {
    background: #F2F7FD;
    border: none;
}
#paperResultsGuide {
    background: #EFF6FF;
    border: @px(1) solid #CFE0F5;
    border-radius: @px(8);
}
#paperResultsGuideTitle {
    color: #1E3A5F;
    font-size: @px(11);
    font-weight: 700;
}
#paperResultsGuideText {
    color: #52647C;
    font-size: @px(11);
}
#sintaScreeningPanel QProgressBar {
    background: #E5EDF8;
    border: none;
    border-radius: @px(2);
}
#sintaScreeningPanel QProgressBar::chunk {
    background: #4F8CFF;
    border-radius: @px(2);
}
#sintaLookupMessage {
    background: #EEF5FF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(6);
    color: #52647C;
    font-size: @px(11);
    padding: @px(4) @px(8);
}

/* ============================================================
   DATASET SEARCH PAGE
   ============================================================ */

#datasetSearchContainer {
    background: transparent;
}

#datasetSearchTitle {
    color: #172033;
    font-size: @px(22);
    font-weight: 750;
}

#datasetSearchSubtitle {
    color: #66768C;
    font-size: @px(12);
    line-height: 1.5;
}

#datasetSearchCard {
    background: #FFFFFF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(14);
}

#datasetSearchInput {
    background: #F7FBFF;
    border: @px(1) solid #D8E5F3;
    border-radius: @px(9);
    color: #25364D;
    font-size: @px(13);
    padding: 0 @px(12);
}

#datasetSearchInput:focus {
    background: #FFFFFF;
    border-color: #8CB9F0;
}

#datasetProviderCombo {
    background: #F7FBFF;
    border: @px(1) solid #D8E5F3;
    border-radius: @px(9);
    color: #344158;
    font-size: @px(13);
    min-width: @px(180);
    padding: 0 @px(10);
}

#datasetProviderCombo:focus {
    border-color: #8CB9F0;
}

#datasetSupportedSourcesLabel {
    color: #8190A4;
    font-size: @px(11);
}

#datasetSourceBadge {
    background: #EEF5FF;
    border: @px(1) solid #D2E3FA;
    border-radius: @px(10);
    color: #3070C8;
    font-size: @px(11);
    font-weight: 700;
    padding: @px(2) @px(10);
}

#datasetSearchStatus {
    color: #64748B;
    font-size: @px(12);
}

#datasetSearchSort {
    background: #FFFFFF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(8);
    color: #344158;
    font-size: @px(12);
    padding: 0 @px(8);
}

#datasetSearchResults {
    background: transparent;
}

#datasetSearchEmpty {
    background: #F7FBFF;
    border: @px(1) solid #E3EDF8;
    border-radius: @px(10);
    color: #7A899C;
    font-size: @px(12);
    line-height: 1.5;
    padding: @px(20) @px(24);
}

#datasetSearchResultsToolbar {
    background: transparent;
}

#datasetSearchDownloadLocation {
    background: #F7FBFF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(10);
}

#datasetSearchDownloadLocationTitle {
    color: #344158;
    font-size: @px(12);
    font-weight: 700;
}

#datasetSearchDownloadLocationPath {
    color: #64748B;
    font-size: @px(11);
}

#datasetSearchLocationAction {
    background: #FFFFFF;
    border: @px(1) solid #CFE3FF;
    border-radius: @px(9);
    padding: 0;
}

#datasetSearchLocationAction:hover {
    background: #F1F7FF;
    border-color: #AFCFFF;
}

#datasetSearchLocationAction:pressed {
    background: #E5F1FF;
    border-color: #8DB8F0;
}

#datasetSearchLocationAction:focus {
    border: @px(2) solid #4D91F2;
}

#datasetSearchLocationAction:disabled {
    background: #EEF2F7;
    border-color: #C9D3E0;
}

/* Dataset result card */
#datasetResultCard {
    background: #FFFFFF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(12);
}

#datasetResultCard:hover {
    border-color: #C2D8F5;
}

#datasetResultName {
    color: #172033;
    font-size: @px(14);
    font-weight: 700;
}

#datasetResultMeta {
    color: #8190A4;
    font-size: @px(11);
}

#datasetResultDescription {
    color: #5A6A7E;
    font-size: @px(12);
    line-height: 1.45;
}

#datasetSourceTag {
    background: #EEF5FF;
    border: @px(1) solid #D2E3FA;
    border-radius: @px(10);
    color: #3277C5;
    font-size: @px(10);
    font-weight: 700;
    padding: @px(2) @px(8);
}

#datasetSourceTag[source="kaggle"] {
    background: #E8F7F0;
    border-color: #C8EDDA;
    color: #1E7A55;
}

#downloadButton {
    background: #4F8CFF;
    border: @px(1) solid #4F8CFF;
    border-radius: @px(8);
    color: #FFFFFF;
    font-size: @px(11);
    font-weight: 700;
    padding: 0 @px(14);
}

#downloadButton:hover {
    background: #3E7EF0;
    border-color: #3E7EF0;
}

#downloadButton:disabled {
    background: #EEF2F7;
    border-color: #C9D3E0;
    color: #8A98AB;
}

#analyzeAfterDownloadButton {
    background: transparent;
    border: @px(1) solid #D2E3FA;
    border-radius: @px(8);
    color: #3277C5;
    font-size: @px(11);
    font-weight: 700;
    padding: 0 @px(14);
}

#analyzeAfterDownloadButton:hover {
    background: #EEF5FF;
    border-color: #A8CBF0;
}

#analyzeAfterDownloadButton:disabled {
    color: #A0B0C5;
    border-color: #E0EAF5;
}

#datasetFileList {
    background: #F7FBFF;
    border: @px(1) solid #E2EDF7;
    border-radius: @px(8);
}

#datasetFileItem {
    color: #3D5270;
    font-size: @px(12);
    padding: @px(4) @px(8);
}

#datasetDownloadProgress {
    background: #E8F0FC;
    border: none;
    border-radius: @px(3);
    max-height: @px(6);
}

#datasetDownloadProgress::chunk {
    background: #4F8CFF;
    border-radius: @px(3);
}

/* Vision Intelligence stays within the shared DORA workspace palette. */
#visionAnalysisTabs::pane {
    background: transparent;
    border: none;
}

#visionAnalysisTabs QTabBar::tab {
    background: #EEF4FC;
    border: @px(1) solid #DCE8F7;
    border-bottom: none;
    border-top-left-radius: @px(8);
    border-top-right-radius: @px(8);
    color: #61728A;
    font-size: @px(12);
    font-weight: 600;
    min-height: @px(34);
    padding: 0 @px(16);
    margin-right: @px(4);
}

#visionAnalysisTabs QTabBar::tab:selected {
    background: #FFFFFF;
    color: #2B6FD8;
    border-color: #CFE3FF;
}

#visionStatCard {
    background: #FFFFFF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(12);
}

#visionMetricTitle, #visionFieldLabel, #visionRecommendationFieldName {
    color: #7D8BA0;
    font-size: @px(10);
    font-weight: 700;
}

#visionMetricValue {
    color: #172033;
    font-size: @px(21);
    font-weight: 750;
}

#visionMetricDetail, #visionMutedLabel {
    color: #8391A4;
    font-size: @px(10);
}

#visionSectionTitle, #visionSubsectionTitle {
    color: #1C2B40;
    font-size: @px(13);
    font-weight: 700;
}

#visionSubsectionTitle { margin-top: @px(4); }

#visionStatusLabel {
    color: #52657D;
    font-size: @px(11);
}

#visionProgressBar {
    background: #E8F0FC;
    border: none;
    border-radius: @px(4);
    color: #52657D;
    max-height: @px(8);
    text-align: center;
}

#visionProgressBar::chunk {
    background: #4F8CFF;
    border-radius: @px(4);
}

QLineEdit#visionDatasetPath, QComboBox#visionTaskSelector {
    background: #FFFFFF;
    border: @px(1) solid #D8E3F1;
    border-radius: @px(8);
    color: #344158;
    min-height: @px(34);
    padding: 0 @px(9);
}

QLineEdit#visionDatasetPath:focus, QComboBox#visionTaskSelector:focus {
    border-color: #8AB7F4;
}

#visionEmptyLabel {
    background: #F7FAFE;
    border: @px(1) dashed #D5E2F1;
    border-radius: @px(8);
    color: #8290A4;
    font-size: @px(11);
    padding: @px(10);
}

#visionDistributionLabel, #visionDistributionValue, #visionDetailValue {
    color: #52657D;
    font-size: @px(11);
}

#visionDistributionBar {
    background: #EAF1FB;
    border: none;
    border-radius: @px(4);
    max-height: @px(9);
}

#visionDistributionBar::chunk {
    background: #77A8F3;
    border-radius: @px(4);
}

#visionGallery {
    background: #F7FAFE;
    border: @px(1) solid #E1EAF5;
    border-radius: @px(9);
    color: #52657D;
    outline: none;
}

#visionGallery::item {
    border: @px(1) solid transparent;
    border-radius: @px(7);
    padding: @px(4);
}

#visionGallery::item:selected {
    background: #E9F2FF;
    border-color: #BDD7FA;
}

#visionSampleViewer {
    background: #F7FAFE;
    border: @px(1) solid #E1EAF5;
    border-radius: @px(9);
    color: #8391A4;
    font-size: @px(11);
    padding: @px(6);
}

#visionQualityNote {
    color: #596A82;
    font-size: @px(11);
}

#visionRecognitionSamples {
    background: #F7FAFE;
    border: @px(1) solid #E1EAF5;
    border-radius: @px(9);
    color: #52657D;
    font-size: @px(11);
    outline: none;
}

#visionRecognitionSamples::item {
    border-bottom: @px(1) solid #E7EEF7;
    min-height: @px(28);
    padding: @px(7) @px(9);
}

#visionRecognitionStatus {
    color: #344158;
    font-size: @px(12);
}

#visionRecognitionNote {
    color: #52657D;
    font-size: @px(11);
}

#visionRecognitionModelTable, #visionRecognitionClassTable, #visionRecognitionConfusionTable {
    font-size: @px(12);
}

#visionRecognitionModelTable::item, #visionRecognitionClassTable::item, #visionRecognitionConfusionTable::item {
    padding: @px(4) @px(7);
}

#visionPrimaryRecommendation, #visionAlternativeRecommendation {
    background: #FFFFFF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(10);
}

#visionPrimaryRecommendation { border-left: @px(3) solid #4F8CFF; }
#visionAlternativeRecommendation { background: #FAFCFF; }

#visionRecommendationEyebrow {
    color: #5482C4;
    font-size: @px(9);
    font-weight: 800;
    letter-spacing: @px(0.5);
}

#visionRecommendationTitle {
    color: #172033;
    font-size: @px(14);
    font-weight: 700;
}

#visionRecommendationTask {
    color: #6E7E93;
    font-size: @px(10);
}

#visionRecommendationFieldValue {
    color: #52657D;
    font-size: @px(10);
}

#visionWarningLabel {
    background: #FFF8E8;
    border: @px(1) solid #F2DEA8;
    border-radius: @px(7);
    color: #87651B;
    font-size: @px(10);
    padding: @px(8);
}

#visionUploadEyebrow {
    color: #6F86A5;
    font-size: @px(10);
    font-weight: 800;
}

#visionUploadCard {
    background: #FFFFFF;
    border: @px(1) solid #DCE8F7;
    border-radius: @px(16);
}

#visionUploadIconBadge {
    background: #4F8CFF;
    border: @px(1) solid #4F8CFF;
    border-radius: @px(20);
}

#visionUploadTitle {
    color: #172033;
    font-size: @px(23);
    font-weight: 750;
}

#visionUploadDescription {
    color: #64758D;
    font-size: @px(12);
}

#visionUploadHint {
    color: #687B95;
    font-size: @px(10);
}

#visionUploadDisclaimer {
    color: #8190A4;
    font-size: @px(10);
}

#visionUploadPrimary {
    background: #4F8CFF;
    border: @px(1) solid #4F8CFF;
    border-radius: @px(9);
    color: #FFFFFF;
    font-size: @px(12);
    font-weight: 700;
    min-height: @px(42);
    padding: 0 @px(18);
}

#visionUploadPrimary:hover {
    background: #3E7EF0;
    border-color: #3E7EF0;
}

#visionUploadPrimary:pressed {
    background: #326FD9;
    border-color: #326FD9;
}

#visionUploadPrimary:disabled {
    background: #AFC8EF;
    border-color: #AFC8EF;
}

#visionUploadSecondary {
    background: #F3F7FD;
    border: @px(1) solid #D5E3F5;
    border-radius: @px(9);
    color: #3277C5;
    font-size: @px(12);
    font-weight: 700;
    min-height: @px(42);
    padding: 0 @px(18);
}

#visionUploadSecondary:hover {
    background: #EAF2FE;
    border-color: #B9D2F1;
}

#visionUploadSecondary:disabled {
    color: #95A6BE;
}

#visionAnalysisScope {
    background: #EEF5FF;
    border: @px(1) solid #D2E3FA;
    border-radius: @px(8);
    color: #3277C5;
    font-size: @px(10);
    font-weight: 700;
    padding: @px(9) @px(12);
}

/* Tanya DORA local assistant */
#tanyaDoraPage { background: #F1F7FF; }
#tanyaDoraTitle {
    color: #172033;
    font-family: "Plus Jakarta Sans";
    font-size: @px(27);
    font-weight: 750;
}
#tanyaDoraSubtitle, #tanyaDoraPrivacyNote, #tanyaDoraActivity {
    color: #7A899C;
    font-size: @px(12);
}
#tanyaDoraStatus {
    background: #EEF5FF;
    border: @px(1) solid #D7E6F8;
    border-radius: @px(10);
    color: #46627F;
    font-size: @px(11);
    padding: @px(9) @px(12);
}
#tanyaDoraStatus[state="ready"] { background: #E9F7ED; border-color: #C7E8D0; color: #236B3B; }
#tanyaDoraStatus[state="warning"] { background: #FFF7E6; border-color: #F1DFB0; color: #806114; }
#tanyaDoraStatus[state="error"] { background: #FFF0EF; border-color: #F1D2CF; color: #9A3F39; }
#tanyaDoraControls,
#tanyaDoraHistoryPanel,
#tanyaDoraChatPanel {
    background: #FFFFFF;
    border: @px(1) solid #D9E7F5;
    border-radius: @px(14);
}
#tanyaDoraFieldLabel { color: #50627A; font-size: @px(11); font-weight: 650; }
#tanyaDoraSectionTitle, #tanyaDoraReferenceHeading {
    color: #24364D;
    font-family: "Plus Jakarta Sans";
    font-size: @px(14);
    font-weight: 700;
}
#tanyaDoraHistoryList, #tanyaDoraSourceList {
    background: transparent;
    border: none;
    outline: none;
    color: #34445C;
    font-size: @px(12);
}
#tanyaDoraHistoryList::item, #tanyaDoraSourceList::item {
    border-radius: @px(7);
    padding: @px(7) @px(8);
}
#tanyaDoraHistoryList::item:hover, #tanyaDoraSourceList::item:hover { background: #F1F6FD; }
#tanyaDoraHistoryList::item:selected, #tanyaDoraSourceList::item:selected {
    background: #E6F0FF;
    color: #075FA6;
}
#tanyaDoraIconButton, #tanyaDoraSmallButton, #tanyaDoraStopButton {
    background: #F7FAFE;
    border: @px(1) solid #D9E5F2;
    border-radius: @px(8);
    color: #376487;
    font-size: @px(11);
    font-weight: 600;
    min-height: @px(30);
    padding: 0 @px(9);
}
#tanyaDoraIconButton { font-size: @px(18); min-width: @px(32); padding: 0; }
#tanyaDoraIconButton:hover, #tanyaDoraSmallButton:hover { background: #EEF5FF; border-color: #B8D1EF; }
#tanyaDoraStopButton { color: #A13A37; border-color: #E7C9C6; }
#tanyaDoraStopButton:enabled:hover { background: #FFF0EF; }
#tanyaDoraStopButton:disabled, #tanyaDoraSmallButton:disabled { color: #9AA7B7; }
#tanyaDoraTranscript {
    background: #FBFDFF;
    border: @px(1) solid #E6EDF5;
    border-radius: @px(10);
    color: #29394E;
    font-size: @px(13);
    padding: @px(12);
    selection-background-color: #C9E0FF;
}
#tanyaDoraReferences { background: #F7FAFE; border: @px(1) solid #E5ECF5; border-radius: @px(9); }
#tanyaDoraReferenceHeading { color: #48627F; font-size: @px(11); min-width: @px(95); }
#tanyaDoraSourceDetail { color: #607188; font-size: @px(10); }
#tanyaDoraInput {
    background: #FFFFFF;
    border: @px(1) solid #CAD9E9;
    border-radius: @px(10);
    color: #24364D;
    font-size: @px(13);
    padding: @px(10);
}
#tanyaDoraInput:focus { border-color: #5B9CDB; }
#tanyaDoraControls QComboBox, #tanyaDoraControls QDoubleSpinBox {
    background: #FFFFFF;
    border: @px(1) solid #D7E2EE;
    border-radius: @px(7);
    color: #29394E;
    min-height: @px(32);
    padding: 0 @px(8);
}
#tanyaDoraControls QComboBox::drop-down { border: none; width: @px(24); }

#tanyaDoraManagementPage { background: #F1F7FF; }
#tanyaDoraStudioTitle {
    color: #172B4D; font-size: @px(25); font-weight: 750;
}
#tanyaDoraStudioSubtitle, #tanyaDoraStudioHint {
    color: #61738A; font-size: @px(11);
}
#tanyaDoraStudioStatus {
    color: #35516F; background: #F7FAFE; border: @px(1) solid #DCE7F3;
    border-radius: @px(8); padding: @px(9) @px(12); font-size: @px(11);
}
#tanyaDoraStudioPanel {
    background: #FFFFFF; border: @px(1) solid #E1E9F3; border-radius: @px(10);
}
#tanyaDoraStudioHeading { color: #29445F; font-size: @px(13); font-weight: 700; }
#tanyaDoraStudioTabs::pane {
    background: #FFFFFF; border: @px(1) solid #E1E9F3; border-radius: @px(9);
    top: -@px(1);
}
#tanyaDoraStudioTabs QTabBar::tab {
    background: #EAF1F9; color: #53677F; border: @px(1) solid #DCE6F1;
    border-bottom: none; border-top-left-radius: @px(7); border-top-right-radius: @px(7);
    padding: @px(9) @px(13); margin-right: @px(3); font-size: @px(11); font-weight: 650;
}
#tanyaDoraStudioTabs QTabBar::tab:selected { background: #FFFFFF; color: #245A8F; }
#tanyaDoraStudioTabs QTabBar::tab:hover:!selected { background: #F3F7FC; }
#tanyaDoraStudioCode {
    background: #F8FAFD; color: #26384D; border: @px(1) solid #DCE5EF;
    border-radius: @px(7); padding: @px(10); font-family: "Intel One Mono"; font-size: @px(10);
}
