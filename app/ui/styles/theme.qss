/* DORA theme tokens. MainWindow resolves placeholders before Qt loads QSS. */
/* @canvas: #f1f7ff */
/* @surface: #ffffff */
/* @ink: #222222 */
/* @heading: #111111 */
/* @body: #564e4e */
/* @muted: #757575 */
/* @border: rgba(0, 107, 184, 0.30) */
/* @border-solid: #c7c6c6 */
/* @blue: #006bb8 */
/* @blue-hover: #0071c2 */
/* @blue-bright: #0d99ff */
/* @switch-off: #e7e7e7 */
/* @blue-active: #c9e0ff */
/* @success: #098e00 */
/* @danger: #e00000 */
/* @amber: #8e6f00 */
/* @overlay: rgba(0, 0, 0, 0.25) */
/* @chart-blue: #0d99ff */
/* @chart-grid: #e5e5e5 */
/* @chart-text: #564e4e */
/* @quality-critical: #fbcaca */
/* @quality-warning: #fffde6 */
/* @quality-good: #d8f8dd */
/* @fingerprint-surface: #eef5ff */
/* @card-radius: 15px */
/* @button-radius: 10px */
/* @small-radius: 8px */
/* @pill-radius: 20px */
/* @dialog-radius: 25px */

QMainWindow,
#appRoot,
#pageStack,
#contentContainer,
#datasetsPage,
#uploadPage,
#datasetsTabPages,
#pageViewport {
    background: var(--canvas);
    color: var(--ink);
}

QWidget {
    color: var(--ink);
    font-family: "Inter";
    font-size: 16px;
}

QLabel#pageTitle,
QLabel#sectionTitle,
QLabel#cardTitle,
QLabel#topbarTitle {
    color: var(--heading);
    font-family: "Plus Jakarta Sans";
    font-weight: 700;
}

QLabel#pageTitle { font-size: 32px; }
QLabel#pageSubtitle,
QLabel#pageDescription,
QLabel#cardDescription { color: var(--body); }
QLabel#pageSubtitle { font-size: 18px; }
QLabel#sectionTitle { font-size: 20px; }
QLabel#cardTitle { font-size: 18px; }
QLabel#cardDescription { font-size: 16px; }

/* Shared application frame */
#sidebarScroll,
#sidebar {
    background: var(--surface);
    border: none;
}
#sidebarScroll { border-right: 1px solid var(--blue-bright); }
#brandLogo {
    background: transparent;
    border: none;
    color: var(--blue);
    font-size: 34px;
    font-weight: 700;
}
#brandTitle,
#brandAccent { color: var(--blue); }
#brandTitle {
    font-family: "Plus Jakarta Sans";
    font-size: 45px;
    font-weight: 800;
}
#brandSubtitle { color: var(--body); font-size: 18px; font-weight: 600; }
#sectionLabel {
    color: var(--muted);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 3px 0 4px 50px;
}
#sidebarMenuCard { background: var(--surface); border: none; border-radius: var(--card-radius); }
#sidebarMenuCard[compact="true"] { border-radius: 0; }
#navButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--button-radius);
    min-height: 43px;
    padding: 0 12px;
    text-align: left;
}
#navButton:hover { background: var(--canvas); }
#navButton[active="true"] {
    background: var(--blue-active);
    border-color: var(--blue-active);
}
#navButton:pressed { background: var(--blue-active); }
#navButton:disabled { color: var(--muted); }
#navIcon { min-width: 28px; }
#navText { color: var(--body); font-size: 20px; }
#navButton[active="true"] #navText {
    color: var(--blue);
    font-weight: 600;
}
#workspaceStatus { background: var(--canvas); border-radius: var(--small-radius); }
#workspaceStatusTitle { color: var(--muted); font-size: 9px; font-weight: 700; }
#workspaceStatusValue { color: var(--success); font-size: 11px; }
#sidebarFooter { color: var(--muted); font-size: 9px; }

#topbar {
    background: var(--surface);
    border: none;
    border-bottom: 1px solid var(--blue-bright);
}
#topbarLink {
    background: var(--surface);
    border: 1px solid transparent;
    border-radius: var(--pill-radius);
    color: var(--body);
    min-height: 50px;
    padding: 0 10px;
    font-size: 25px;
}
#topbarLink::icon { width: 35px; height: 35px; }
#topbarLink:hover { background: var(--canvas); }
#topbarLink:pressed { background: var(--blue-active); }
#topbarLink[active="true"] {
    background: var(--blue-active);
    color: var(--blue);
}
#topbarDivider { background: var(--border-solid); }
#topbarVersion { color: var(--muted); font-size: 15px; }
#topbarVersionIcon { background: transparent; }
QScrollArea { background: var(--canvas); border: none; }
QAbstractScrollArea { background: var(--canvas); }
QAbstractScrollArea::viewport { background: var(--canvas); }
QScrollArea#datasetPreviewScroll,
QScrollArea#datasetPreviewScroll::viewport,
QWidget#datasetPreviewContainer { background: var(--canvas); border: none; }

/* Help page */
#helpPageTitle { color: var(--heading); font-size: 24px; font-weight: 700; }
#helpPageSubtitle { color: var(--muted); font-size: 14px; }
#helpHero { background: var(--blue-active); border: 1px solid var(--blue-bright); border-radius: var(--card-radius); }
#helpHeroTitle { color: var(--blue); font-size: 17px; font-weight: 700; }
#helpHeroBody, #helpBody { color: var(--body); font-size: 13px; }
#helpInfoCard { background: var(--surface); border: 1px solid var(--border); border-radius: var(--card-radius); }
#helpCardTitle { color: var(--heading); font-size: 15px; font-weight: 700; }
QPushButton#helpShortcut { background: var(--surface); border: 1px solid var(--blue-bright); border-radius: var(--button-radius); color: var(--blue); font-size: 13px; font-weight: 600; min-height: 38px; padding: 0 12px; }
QPushButton#helpShortcut:hover { background: var(--blue-active); }
QPushButton#helpShortcut:pressed { background: var(--blue-bright); color: var(--surface); }

/* Shared cards, form controls, buttons, and tables */
#contentCard,
#statCard,
#currentDatasetCard,
#quickActionCard,
#metricCard,
#researchCard,
#uploadCard,
#pipelineCard,
#pipelineStageCard,
#heroCard,
#heroVisual,
#researchStatus,
#datasetPreviewFileCard,
#datasetPreviewMetricCard,
#datasetPreviewTableCard,
#datasetPreviewColumnsCard,
#datasetSearchCard,
#datasetResultCard,
#metricCard {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--card-radius);
}

#researchSectionDivider { background: var(--border); border: none; }
#researchPaperPreviewRow { background: var(--canvas); border: 1px solid var(--border); border-radius: var(--small-radius); }
#researchPaperPreviewRank { background: var(--blue-active); border-radius: var(--pill-radius); color: var(--blue); font-size: 13px; font-weight: 700; padding: 6px; }
#researchPaperPreviewTitle { color: var(--heading); font-size: 15px; font-weight: 600; }

QPushButton#primaryButton,
QPushButton#analyzeButton,
QPushButton#runButton,
QPushButton#uploadButton {
    background: var(--blue);
    border: 1px solid var(--blue);
    border-radius: var(--button-radius);
    color: var(--surface);
    font-weight: 600;
    font-size: 18px;
    padding: 0 18px;
}
QPushButton#primaryButton:hover,
QPushButton#analyzeButton:hover,
QPushButton#runButton:hover,
QPushButton#uploadButton:hover { background: var(--blue-hover); border-color: var(--blue-hover); }
QPushButton#datasetPreviewUploadButton { background: var(--blue); border: 1px solid var(--blue); border-radius: var(--small-radius); color: var(--surface); min-height: 61px; padding: 0; }
QPushButton#datasetPreviewUploadButton:hover { background: var(--blue-hover); border-color: var(--blue-hover); }
QPushButton#datasetPreviewUploadButton:pressed { background: var(--blue); }
QPushButton#datasetPreviewUploadButton:disabled { background: var(--border-solid); border-color: var(--border-solid); }
#datasetPreviewUploadIcon { background: transparent; border: none; }
#datasetPreviewUploadText { color: var(--surface); font-size: 18px; font-weight: 600; }
QPushButton#primaryButton:pressed,
QPushButton#analyzeButton:pressed,
QPushButton#runButton:pressed,
QPushButton#uploadButton:pressed { background: var(--blue); }
QPushButton#primaryButton:disabled,
QPushButton#analyzeButton:disabled,
QPushButton#runButton:disabled,
QPushButton#uploadButton:disabled { background: var(--border-solid); border-color: var(--border-solid); color: var(--muted); }
QPushButton#primaryButton[analysisRun="true"] { font-size: 23px; min-height: 64px; padding: 0 24px; }

QPushButton#secondaryButton,
#uploadSearchButton {
    background: var(--surface);
    border: 1px solid var(--blue-bright);
    border-radius: var(--button-radius);
    color: var(--blue);
    font-weight: 600;
    font-size: 18px;
    padding: 0 14px;
}
QPushButton#secondaryButton:hover,
#uploadSearchButton:hover { background: var(--canvas); }
QPushButton#secondaryButton:pressed,
#uploadSearchButton:pressed { background: var(--blue-active); }

QLineEdit,
QComboBox,
QTextEdit,
QTextBrowser,
QDateEdit,
QSpinBox {
    background: var(--surface);
    border: 1px solid var(--border-solid);
    border-radius: var(--small-radius);
    color: var(--ink);
    padding: 8px 12px;
    selection-background-color: var(--blue-active);
}
QLineEdit:focus,
QComboBox:focus,
QTextEdit:focus,
QTextBrowser:focus { border: 1px solid var(--blue-bright); }
QLineEdit:disabled,
QComboBox:disabled,
QTextEdit:disabled { background: var(--canvas); color: var(--muted); }
QComboBox QAbstractItemView {
    background: var(--surface);
    border: 1px solid var(--border-solid);
    selection-background-color: var(--blue-active);
}
QTabWidget::pane { border: 1px solid var(--border); border-radius: var(--small-radius); background: var(--surface); }
#datasetsTabs, #datasetsTabs::pane { background: var(--canvas); border: none; border-radius: 0; }
QTabBar::tab {
    background: transparent;
    border: none;
    color: var(--body);
    padding: 10px 14px;
}
QTabBar::tab:hover { color: var(--blue); }
QTabBar::tab:selected { color: var(--blue); border-bottom: 2px solid var(--blue); font-weight: 600; }
QTableView,
QTableWidget {
    background: var(--surface);
    alternate-background-color: var(--canvas);
    border: 1px solid var(--border-solid);
    gridline-color: var(--border-solid);
    selection-background-color: var(--blue-active);
    selection-color: var(--ink);
}
QHeaderView::section {
    background: var(--canvas);
    border: none;
    border-bottom: 1px solid var(--border-solid);
    color: var(--body);
    font-weight: 600;
    padding: 8px;
}
QScrollBar:vertical { width: 10px; background: transparent; margin: 0; }
QScrollBar::handle:vertical { background: var(--border-solid); border-radius: 5px; min-height: 28px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* Dataset: upload */
#uploadPage QLabel#pageSubtitle,
#datasetPreviewHeader QLabel#pageSubtitle { font-size: 23px; }
#uploadPageSectionTitle { color: var(--heading); font-family: "Inter"; font-size: 25px; font-weight: 700; }
#uploadDropzone { background: var(--surface); border: 2px dashed var(--blue-bright); border-radius: var(--small-radius); }
#uploadDropIcon { background: transparent; border: none; }
#uploadSearchIcon { background: var(--blue-active); border-radius: 14px; }
#uploadStepBadge { background: var(--blue-active); border-radius: 20px; color: var(--blue); font-size: 16px; font-weight: 700; }
#uploadDropTitle { color: var(--heading); font-size: 25px; font-weight: 700; }
#uploadDropDescription, #uploadDropSizeLimit { color: var(--body); font-size: 23px; }
#uploadStepDetail { color: var(--body); font-size: 16px; }
#uploadTipsText { color: var(--body); font-size: 16px; }
#uploadBrowseLink { background: transparent; border: none; color: var(--blue-bright); font-size: 23px; padding: 0; font-weight: 600; }
#uploadBrowseLink:hover { color: var(--blue); text-decoration: underline; }
#uploadStep, #uploadSearchCard, #uploadTipsCard { background: var(--surface); border: 1px solid var(--border); border-radius: var(--small-radius); }
#uploadSearchCard, #uploadTipsCard { border-radius: var(--card-radius); }
#uploadStepTitle { color: var(--heading); font-size: 20px; font-weight: 700; }
#uploadSearchCard #cardTitle, #uploadTipsCard #cardTitle { color: var(--heading); font-family: "Inter"; font-size: 20px; font-weight: 600; }
#uploadSearchCard #cardDescription { font-size: 16px; }
#uploadSearchButton { text-align: left; padding-left: 13px; }

/* Dataset: loaded */
#datasetPreviewHeader { background: transparent; border: none; }
#datasetPreviewFooter { background: var(--surface); border: none; border-radius: var(--card-radius); }
#datasetPreviewLoadedBadge { background: var(--quality-good); border-radius: var(--pill-radius); color: var(--success); font-size: 12px; font-weight: 700; padding: 6px 10px; }
#datasetPreviewFileIdentity { background: var(--surface); border: 2px dashed var(--blue-bright); border-radius: 0; }
#datasetPreviewFileName { color: var(--heading); font-size: 20px; font-weight: 700; }
#datasetPreviewFileDetails { color: var(--body); font-size: 17px; }
#datasetPreviewFooterText { color: var(--muted); font-size: 16px; font-weight: 600; }
#datasetPreviewFileIcon { background: var(--blue-active); border: none; border-radius: var(--pill-radius); color: var(--blue); font-size: 16px; font-weight: 700; }
#datasetPreviewFileCard QPushButton#secondaryButton { border-radius: var(--small-radius); }
#datasetPreviewFooter QPushButton#primaryButton { border-radius: var(--small-radius); }
#datasetPreviewMetricTitle { color: var(--body); font-size: 14px; font-weight: 700; }
#datasetPreviewMetricValue { color: var(--heading); font-size: 36px; font-weight: 700; }
#datasetPreviewMetricDescription { color: #8e8c8c; font-size: 18px; }
#datasetPreviewTabs { background: transparent; border: none; border-radius: 0; min-height: 54px; }
#datasetPreviewTabsScroll, #datasetPreviewTabsScroll QWidget { background: transparent; border: none; }
QPushButton#datasetPreviewTab { background: transparent; border: none; border-bottom: 3px solid transparent; border-radius: 0; color: var(--muted); font-size: 20px; min-height: 54px; padding: 0 16px; }
QPushButton#datasetPreviewTab:hover { color: var(--blue); }
QPushButton#datasetPreviewTab[active="true"] { border-bottom: 3px solid var(--blue-bright); color: var(--blue); font-weight: 600; }
#datasetPreviewTableCard, #datasetPreviewColumnsCard { background: var(--surface); }
#datasetPreviewSectionTitle { color: var(--heading); font-family: "Plus Jakarta Sans"; font-size: 20px; font-weight: 700; }
#datasetPreviewCount { color: var(--muted); font-size: 16px; }
QTableView#datasetPreviewTable { background: var(--surface); border: none; color: var(--body); font-size: 15px; gridline-color: #e3e8ef; }
QTableView#datasetPreviewTable::item { padding-left: 28px; padding-right: 0; border-bottom: 1px solid #e3e8ef; }
QTableView#datasetPreviewTable QHeaderView::section { background: #e3efff; border: none; color: var(--body); font-size: 14px; font-weight: 700; padding-left: 24px; padding-right: 0; }
#datasetPreviewColumnHeader { color: var(--muted); font-size: 10px; font-weight: 700; letter-spacing: 0.5px; }
#datasetPreviewColumnRow { background: transparent; border: none; border-bottom: 1px solid #d5d5d5; }
#datasetPreviewColumnName { color: var(--body); font-size: 14px; font-weight: 600; }
#datasetPreviewTypeBadge { background: #e5e5e5; border-radius: var(--pill-radius); color: #757575; font-size: 12px; font-weight: 600; padding: 2px 4px; }
#datasetPreviewTypeBadge[columnType="target"] { background: #d8f8dd; color: #098e00; }
#datasetPreviewTypeBadge[columnType="categorical"] { background: #fff7cc; color: #8e6f00; }
#datasetPreviewTypeBadge[columnType="numeric"] { background: #e2efff; color: #0071c2; }
#datasetPreviewMissingValue { color: var(--muted); font-size: 14px; }
#datasetPreviewMissingValue[hasMissing="true"] { color: var(--danger); }
#datasetPreviewColumnsScroll, #datasetPreviewColumnsScroll QWidget#datasetPreviewColumnsContent { background: var(--surface); border: none; }
#datasetPreviewContentStack, #datasetPreviewBody, #datasetPreviewAnalysisPage { background: transparent; border: none; }
#datasetPreviewAnalysisCard { background: var(--surface); border: 1px solid var(--border); border-radius: var(--card-radius); }
#datasetPreviewAnalysisDescription { color: var(--muted); font-size: 14px; }
#datasetPreviewAnalysisSummary { background: var(--blue-active); border-radius: var(--small-radius); color: var(--blue); font-size: 14px; padding: 10px 12px; }
QTableView#datasetPreviewAnalysisTable { background: var(--surface); alternate-background-color: var(--canvas); border: 1px solid var(--border-solid); color: var(--ink); font-size: 14px; gridline-color: #e3e8ef; selection-background-color: var(--blue-active); selection-color: var(--ink); }
QTableView#datasetPreviewAnalysisTable QHeaderView::section { background: var(--canvas); border: none; border-bottom: 1px solid var(--border-solid); color: var(--body); font-size: 13px; font-weight: 600; padding: 10px 12px; }

/* Guided analysis editor */
#editorAnalysisScroll, #editorAnalysisContent { background: var(--canvas); border: none; }
#editorAnalysisStepsCard, #editorAnalysisCodeCard { background: var(--surface); border: 1px solid var(--border); border-radius: var(--card-radius); }
#editorAnalysisSectionTitle { color: var(--heading); font-family: "Plus Jakarta Sans"; font-size: 19px; font-weight: 700; }
#editorAnalysisMuted { color: var(--muted); font-size: 14px; }
#editorAnalysisDatasetBadge { background: var(--blue-active); border-radius: var(--pill-radius); color: var(--blue); font-size: 13px; font-weight: 600; padding: 8px 13px; }
#editorAnalysisInfoBanner { background: #fffde6; border: 1px solid #f2e4a6; border-radius: var(--small-radius); color: var(--body); font-size: 14px; padding: 11px 14px; }
#editorAnalysisStepList { background: transparent; border: none; outline: none; }
#editorAnalysisStepList::item { border-radius: var(--small-radius); color: var(--body); min-height: 44px; padding: 8px 10px; }
#editorAnalysisStepList::item:hover { background: var(--canvas); }
#editorAnalysisStepList::item:selected { background: var(--blue-active); color: var(--blue); font-weight: 600; }
#editorAnalysisTemplateCombo, #editorAnalysisCategoryCombo, #editorAnalysisTargetCombo { background: var(--surface); border: 1px solid var(--border); border-radius: var(--button-radius); color: var(--ink); min-height: 38px; padding: 0 10px; }
#editorAnalysisTargetCombo { min-width: 190px; }
#editorAnalysisLibraryInput { background: var(--surface); border: 1px solid var(--border); border-radius: var(--button-radius); color: var(--ink); min-height: 38px; padding: 0 10px; }
#editorAnalysisFieldLabel { color: var(--body); font-size: 14px; font-weight: 600; }
QPlainTextEdit#editorAnalysisCodeEditor { background: #172338; border: 1px solid #243954; border-radius: var(--small-radius); color: #e8f1ff; font-family: "Intel One Mono"; font-size: 14px; padding: 14px; selection-background-color: #285b91; }
#editorAnalysisExecutionNote { background: var(--canvas); border-radius: var(--small-radius); color: var(--muted); font-size: 13px; padding: 9px 11px; }
#editorAnalysisOutputTabs { background: var(--surface); border: 1px solid var(--border); border-radius: var(--small-radius); }
#editorAnalysisOutputTabs::pane { border: none; }
QPlainTextEdit#editorAnalysisOutputText { background: #f8fbff; border: none; color: var(--body); font-family: "Intel One Mono"; font-size: 13px; padding: 10px; }
#editorAnalysisGraphicsScroll, #editorAnalysisGraphicsContent { background: var(--surface); border: none; }
#editorAnalysisGraphicsEmpty { color: var(--muted); font-size: 14px; min-height: 120px; }
#editorAnalysisOutputGraph { background: var(--surface); border: 1px solid var(--border); border-radius: var(--small-radius); padding: 6px; }

/* Dataset search */
#datasetSearchResults { background: var(--canvas); border: none; }
#datasetSearchCard { background: var(--surface); border: 1px solid var(--border); border-radius: var(--card-radius); }
QLabel#datasetSearchSubtitle { color: var(--body); font-size: 20px; }
QLineEdit#datasetSearchInput { background: var(--surface); border: 1px solid var(--blue-bright); border-radius: var(--small-radius); color: var(--ink); font-size: 22px; min-height: 66px; padding: 0 24px; }
QLineEdit#datasetSearchInput:focus { border: 1px solid var(--blue); }
QComboBox#datasetProviderCombo { background: var(--surface); border: 1px solid var(--border-solid); border-radius: var(--small-radius); color: var(--ink); font-size: 22px; min-height: 66px; padding: 0 18px; }
QPushButton#primaryButton[datasetSearch="true"] { font-size: 22px; min-height: 66px; padding: 0 20px; }
#datasetSearchCard #cardDescription { color: var(--body); font-size: 20px; }
#datasetResultCard { background: var(--surface); border: 1px solid var(--border); border-radius: var(--card-radius); }
#datasetResultTitle { color: var(--heading); font-family: "Plus Jakarta Sans"; font-size: 22px; font-weight: 700; }
#datasetResultCard #cardDescription { color: var(--body); font-size: 18px; }
#datasetResultCard #scoreBadge { background: #d8f8dd; border: none; border-radius: var(--small-radius); color: var(--success); font-size: 16px; font-weight: 600; padding: 6px 14px; }
#datasetResultTag { background: #e5e5e5; border: none; border-radius: var(--pill-radius); color: var(--body); font-size: 15px; padding: 4px 12px; }
QComboBox#datasetFileSelect { background: var(--surface); border: 1px solid var(--border-solid); border-radius: var(--small-radius); color: var(--ink); font-size: 19px; min-height: 54px; padding: 0 16px; }
QPushButton#datasetAnalyzeButton { background: var(--blue); border: 1px solid var(--blue); border-radius: var(--button-radius); color: var(--surface); font-size: 18px; font-weight: 600; min-height: 48px; padding: 0 16px; }
QPushButton#datasetAnalyzeButton:hover { background: var(--blue-hover); border-color: var(--blue-hover); }
QPushButton#datasetAnalyzeButton:pressed { background: var(--blue); }
QPushButton#datasetAnalyzeButton:disabled { background: var(--border-solid); border-color: var(--border-solid); color: var(--muted); }

/* Research Landscape */
QPushButton#landscapeSearchButton { background: var(--blue); border: 1px solid var(--blue); border-radius: var(--button-radius); color: var(--surface); font-size: 22px; font-weight: 600; min-height: 66px; padding: 0 20px; }
QPushButton#landscapeSearchButton:hover { background: var(--blue-hover); border-color: var(--blue-hover); }
QPushButton#landscapeSearchButton:pressed { background: var(--blue); }
QPushButton#landscapeSearchButton:disabled { background: var(--border-solid); border-color: var(--border-solid); color: var(--muted); }
#landscapeStatus { color: var(--body); font-size: 20px; }
QScrollArea#landscapeScroll { background: var(--canvas); border: none; }
QScrollArea#landscapeDistributionViewport { background: var(--canvas); border: none; }
QWidget#researchLandscapeContainer, QWidget#landscapeMetricsRow, QWidget#landscapeDistributionRow { background: var(--canvas); border: none; }
#landscapeMetricCard, #landscapeDistributionCard { background: var(--surface); border: 1px solid var(--border); border-radius: var(--card-radius); }
#landscapeMetricTitle { color: var(--body); font-size: 16px; font-weight: 700; }
#landscapeMetricValue { color: var(--heading); font-family: "Plus Jakarta Sans"; font-size: 38px; font-weight: 700; }
#landscapeMetricSubtitle { color: #8c8c8c; font-size: 20px; }
#landscapeDistributionTitle { color: var(--heading); font-family: "Plus Jakarta Sans"; font-size: 29px; font-weight: 700; }
#landscapeMethodLabel { color: var(--ink); font-size: 25px; }
QProgressBar#landscapeMethodBar { background: #e3efff; border: none; border-radius: 4px; max-height: 8px; min-height: 8px; }
QProgressBar#landscapeMethodBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #bcd9ff, stop:1 var(--blue)); border: none; border-radius: 4px; }
#landscapeMethodValue { background: var(--quality-good); border: none; border-radius: 12px; color: var(--success); font-size: 15px; font-weight: 600; min-width: 30px; padding: 2px 8px; }
#landscapeMethodEmpty { color: var(--muted); font-size: 18px; }

/* Analysis and research surfaces */
#analysisDatasetBanner { background: var(--surface); border: 1px solid var(--border); border-radius: var(--card-radius); min-height: 86px; }
#analysisDatasetName { color: var(--heading); font-family: "Plus Jakarta Sans"; font-size: 24px; font-weight: 700; }
#analysisDatasetMetrics { color: var(--body); font-size: 22px; }
#analysisSubtitle { color: var(--body); font-size: 22px; }
#analysisOverview { background: transparent; border: none; }
#analysisFingerprintCard, #analysisQualitySummaryCard { background: var(--surface); border: 1px solid var(--border); border-radius: var(--card-radius); }
#analysisPanelTitle { color: var(--heading); font-family: "Plus Jakarta Sans"; font-size: 24px; font-weight: 700; }
#analysisPanelSubtitle { color: var(--muted); font-size: 18px; }
#analysisFingerprintValue { background: var(--fingerprint-surface); border: none; border-radius: var(--small-radius); color: var(--body); font-family: "Intel One Mono"; font-size: 16px; padding: 12px; }
#analysisQualityCritical { background: var(--quality-critical); border: none; border-radius: var(--small-radius); }
#analysisQualityWarning { background: var(--quality-warning); border: none; border-radius: var(--small-radius); }
#analysisQualityGood { background: var(--quality-good); border: none; border-radius: var(--small-radius); }
#analysisVisualizationTitle { color: var(--heading); font-family: "Plus Jakarta Sans"; font-size: 24px; font-weight: 700; }
#analysisControlLabel { color: var(--body); font-size: 18px; }
QComboBox#analysisControlSelect { background: var(--surface); border: 1px solid var(--border); border-radius: var(--card-radius); color: var(--ink); font-size: 20px; min-height: 66px; padding: 0 18px; }
QComboBox#analysisControlSelect:focus { border: 1px solid var(--blue-bright); }
QComboBox#analysisControlSelect QAbstractItemView { background: var(--surface); selection-background-color: var(--blue-active); }
#analysisChartMessage { color: var(--muted); font-size: 18px; }
#readinessTitle { color: var(--heading); font-size: 14px; font-weight: 700; }
#readinessMetric { background: var(--canvas); border: 1px solid var(--blue-active); border-radius: var(--small-radius); }
#readinessMetricValue { color: var(--ink); font-size: 14px; font-weight: 700; }
#readinessMetricLabel, #readinessRecommendation, #statusLabel { color: var(--muted); }
#readinessStatus { border-radius: var(--small-radius); padding: 5px 9px; }
#chartCanvas { background: var(--surface); }
#metricTitle { color: var(--body); font-size: 9px; font-weight: 700; }
#metricValue { color: var(--heading); font-size: 20px; font-weight: 700; }

/* Dialogs */
QDialog { background: var(--surface); border-radius: var(--dialog-radius); }
QDialog#uploadDatasetDialog { background: transparent; border: none; border-radius: var(--dialog-radius); }
#uploadDialogSurface { background: var(--surface); border: none; border-radius: var(--dialog-radius); }
QScrollArea#uploadDialogContent,
QScrollArea#uploadDialogContent::viewport,
#uploadDialogViewport,
#uploadDialogContentBody { background: transparent; border: none; }
#dialogOverlay { background: var(--overlay); border: none; }
#uploadDialogTitle { color: var(--heading); font-family: "Plus Jakarta Sans"; font-size: 30px; font-weight: 700; }
#uploadDialogSubtitle { color: var(--body); font-size: 20px; }
#uploadDialogFileCard { background: var(--canvas); border: 1px solid var(--blue-bright); border-radius: var(--dialog-radius); }
#uploadDialogFileIcon { background: var(--blue-active); border-radius: 16px; }
#uploadDialogFileName { color: var(--heading); font-size: 24px; font-weight: 700; }
#uploadDialogFileDetails { color: var(--body); font-size: 18px; }
#uploadDialogLabel { color: var(--muted); font-size: 16px; font-weight: 600; }
QLineEdit#uploadDialogInput,
QComboBox#uploadDialogInput {
    background: var(--surface);
    border: 1px solid var(--blue-bright);
    border-radius: var(--dialog-radius);
    color: var(--ink);
    font-size: 20px;
    min-height: 64px;
    padding: 0 24px;
}
QLineEdit#uploadDialogInput:focus,
QComboBox#uploadDialogInput:focus { border: 1px solid var(--blue); }
QCheckBox#uploadDialogCheck { color: var(--ink); font-size: 18px; spacing: 12px; }
QCheckBox#uploadDialogCheck::indicator { width: 46px; height: 28px; border: 1px solid var(--border-solid); border-radius: 14px; background: var(--switch-off); }
QCheckBox#uploadDialogCheck::indicator:checked { background: var(--blue-bright); border-color: var(--blue-bright); }
QDialog#uploadDatasetDialog QPushButton#primaryButton { font-size: 18px; }
QPushButton#uploadDialogCancel {
    background: var(--surface);
    border: 1px solid var(--blue-bright);
    border-radius: var(--button-radius);
    color: var(--blue);
    font-size: 18px;
    font-weight: 600;
    min-height: 64px;
}
QDialog#uploadDatasetDialog QPushButton#uploadDialogCancel { color: var(--blue); font-size: 18px; }
QPushButton#uploadDialogCancel:hover { background: var(--canvas); }
QPushButton#uploadDialogCancel:pressed { background: var(--blue-active); }
QDialog#uploadDatasetDialog[compact="true"] #uploadDialogTitle { font-size: 24px; }
QDialog#uploadDatasetDialog[compact="true"] #uploadDialogSubtitle { font-size: 16px; }
QDialog#uploadDatasetDialog[compact="true"] #uploadDialogFileName { font-size: 19px; }
QDialog#uploadDatasetDialog[compact="true"] #uploadDialogFileDetails { font-size: 14px; }
QDialog#uploadDatasetDialog[compact="true"] #uploadDialogLabel { font-size: 13px; }
QDialog#uploadDatasetDialog[compact="true"] QLineEdit#uploadDialogInput,
QDialog#uploadDatasetDialog[compact="true"] QComboBox#uploadDialogInput {
    font-size: 16px;
    min-height: 52px;
    padding: 0 16px;
}
QDialog#uploadDatasetDialog[compact="true"] QCheckBox#uploadDialogCheck { font-size: 14px; }
QDialog#uploadDatasetDialog[compact="true"] QCheckBox#uploadDialogCheck::indicator {
    width: 38px;
    height: 24px;
}
QDialog#uploadDatasetDialog[compact="true"] QPushButton#primaryButton {
    font-size: 14px;
    min-height: 52px;
}
QDialog#uploadDatasetDialog[compact="true"] QPushButton#uploadDialogCancel {
    font-size: 14px;
    min-height: 52px;
}

/* Notebook-style plot area uses the same font and palette as the UI. */
