QWidget#sidebar[figmaAnalysis="true"] QPushButton#navButton:hover { background: #F5F8FD; }
QPushButton#navButton[figmaAnalysis="true"]:hover { background: #F5F8FD; }
QWidget#sidebar[figmaAnalysis="true"] QPushButton#navButton[active="true"] { background: #EEF4FF; border-color: #EEF4FF; }
QPushButton#navButton[figmaAnalysis="true"][active="true"] { background: #EEF4FF; border-color: #EEF4FF; }
QWidget#sidebar[figmaAnalysis="true"] QLabel#navText { color: #536174; font-size: @px(13); font-weight: 500; }
QLabel#navText[figmaAnalysis="true"] { color: #536174; font-size: @px(13); font-weight: 500; }
QWidget#sidebar[figmaAnalysis="true"] QPushButton#navButton[active="true"] QLabel#navText { color: #0861EF; font-weight: 600; }
QPushButton#navButton[figmaAnalysis="true"][active="true"] QLabel#navText[figmaAnalysis="true"] { color: #0861EF; font-weight: 600; }
QWidget#sidebar[figmaAnalysis="true"] QFrame#sidebarMenuCard[compact="true"] { border-radius: 0; }

/* Keep the shared navigation palette consistent across every active page. */
QWidget#sidebar QPushButton#navButton QLabel#navText {
    color: #536174;
    font-weight: 500;
}
QWidget#sidebar[figmaPage4="true"] QLabel#navText[figmaPage4="true"] {
    color: #536174;
    font-weight: 500;
}
QWidget#sidebar QPushButton#navButton[active="true"] QLabel#navText,
QWidget#sidebar[figmaPage4="true"] QLabel#navText[figmaPage4="true"][active="true"] {
    color: #0861EF;
    font-weight: 600;
}

/* Shared DORA surfaces for active pages without a dedicated Figma frame. */
QWidget#papersToolPage,
QWidget#researchInsightsPage,
QWidget#researchLandscapeToolPage,
QWidget#researchGapToolPage,
QWidget#researchReportPage,
QWidget#aboutFigmaPage,
QWidget#copyrightPage,
QWidget#helpPage {
    background: #F6FBFF;
    color: #0C1648;
}
QLabel#creditsEyebrow {
    color: #2B69C8;
    font-family: "Segoe UI";
    font-size: @px(10);
    font-weight: 700;
    letter-spacing: @px(1.2);
}
QFrame#creditsCodePanel {
    background: #1B2029;
    border: 1px solid #303A49;
    border-radius: @px(12);
}
QLabel#creditsPanelTitle {
    color: #D8E3F0;
    font-family: "Segoe UI";
    font-size: @px(12);
    font-weight: 600;
}
QLabel#creditsLanguageBadge {
    background: #2B3441;
    border-radius: @px(4);
    color: #A9D7FF;
    font-family: "Segoe UI";
    font-size: @px(9);
    font-weight: 700;
    padding: @px(3) @px(7);
}
QTextBrowser#creditsManifestCode {
    background: #1B2029;
    border: none;
    color: #DCE5F1;
    font-family: "Consolas", "Cascadia Code", monospace;
    font-size: @px(12);
    padding: @px(12) 0;
    selection-background-color: #344B67;
}
QLabel#creditsCopyright {
    color: #687A96;
    font-family: "Segoe UI";
    font-size: @px(11);
}
QScrollArea#researchLandscapePageScroll,
QScrollArea#researchGapPageScroll,
QScrollArea#researchReportPageScroll,
QScrollArea#helpScroll,
QWidget#researchLandscapePageContent,
QWidget#researchGapPageContent,
QWidget#researchReportContent,
QWidget#helpContainer,
QWidget#aboutFigmaCanvas {
    background: #F6FBFF;
    border: none;
}
QFrame#researchCard,
QFrame#contentCard,
QFrame#paperScreeningToolbar,
QFrame#paperSelectionPanel,
QFrame#sintaScreeningPanel,
QFrame#nonSintaScreeningPanel,
QFrame#helpInfoCard,
QFrame#aboutInfoCard {
    background: #FFFFFF;
    border: 1px solid #DDEAFF;
    border-radius: @px(12);
}
QWidget#papersToolPage QPushButton#primaryButton,
QWidget#researchInsightsPage QPushButton#primaryButton,
QWidget#researchReportPage QPushButton#primaryButton {
    background: #0060FF;
    border: 1px solid #0060FF;
    border-radius: @px(7);
    color: #FFFFFF;
}
QWidget#papersToolPage QPushButton#primaryButton:hover,
QWidget#researchInsightsPage QPushButton#primaryButton:hover,
QWidget#researchReportPage QPushButton#primaryButton:hover {
    background: #0758D9;
    border-color: #0758D9;
}
QWidget#papersToolPage QPushButton#secondaryButton,
QWidget#researchInsightsPage QPushButton#secondaryButton,
QWidget#researchReportPage QPushButton#secondaryButton {
    background: #FFFFFF;
    border: 1px solid #0060FF;
    border-radius: @px(7);
    color: #0060FF;
}
QWidget#papersToolPage QPushButton#secondaryButton:hover,
QWidget#researchInsightsPage QPushButton#secondaryButton:hover,
QWidget#researchReportPage QPushButton#secondaryButton:hover {
    background: #F2F7FF;
}
QTextBrowser#researchReportPreview {
    background: #FFFFFF;
    border: 1px solid #D7E2F0;
    border-radius: @px(10);
    color: #172033;
    selection-background-color: #CFE0FB;
    padding: @px(16);
}
