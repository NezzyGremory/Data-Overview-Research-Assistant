QFrame#overviewPipelineStage[state="complete"] QLabel#overviewStageStatus { color: var(--overview-green); }
QLabel#overviewStageStatus[complete="true"] { color: var(--overview-green); }
QFrame#overviewPipelineStage[kind="report"] { background: var(--overview-report-muted); }
QFrame#overviewPipelineStage[kind="report"] QLabel#overviewStageStatus,
QLabel#overviewStageStatus[complete="true"][kind="report"] { color: var(--blue); }
QLabel#overviewCardTitle {
    color: #000000;
    font-family: "Plus Jakarta Sans";
    font-size: 24px;
    font-weight: 700;
}
QLabel#overviewCardIcon { background: #e3efff; border: none; border-radius: 16px; }
QLabel#overviewDatasetName { color: #111111; font-size: 18px; font-weight: 700; }
QLabel#overviewLoadedBadge {
    background: #bdffc8;
    border: none;
    border-radius: 12px;
    color: #008000;
    font-size: 14px;
