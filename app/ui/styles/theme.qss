/* DORA theme tokens. MainWindow resolves placeholders before Qt loads QSS. */
/* @canvas: #f1f7ff */
/* @credits-bg: rgba(7, 26, 50, 232) */
/* @credits-font: "Georgia" */
/* @surface: #ffffff */
/* @ink: #222222 */
/* @heading: #111111 */
/* @body: #564e4e */
/* @muted: #757575 */
/* @border: rgba(0, 107, 184, 0.30) */
/* @border-solid: #c7c6c6 */
/* @blue: #006bb8 */
/* @blue-hover: #0071c2 */
/* @blue-bright: #0d99ff */
/* @switch-off: #e7e7e7 */
/* @blue-active: #c9e0ff */
/* @success: #098e00 */
/* @danger: #e00000 */
/* @amber: #8e6f00 */
/* @overlay: rgba(0, 0, 0, 0.25) */
/* @chart-blue: #0d99ff */
/* @chart-grid: #e5e5e5 */
/* @chart-text: #564e4e */
/* @quality-critical: #fbcaca */
/* @quality-warning: #fffde6 */
/* @quality-good: #d8f8dd */
/* @fingerprint-surface: #eef5ff */
/* @card-radius: 15px */
/* @button-radius: 10px */
/* @small-radius: 8px */
/* @pill-radius: 20px */
/* @dialog-radius: 25px */
/* @overview-key-bg: rgba(201, 224, 255, 0.5) */
/* @overview-stage-bg: rgba(148, 255, 165, 0.5) */
/* @overview-stage-border: rgba(2, 97, 18, 0.4) */
/* @overview-green: #098e00 */
/* @overview-blue-soft: #e8f1ff */
/* @overview-report-muted: #c9e0ff */
/* @about-card-bg: rgba(255, 255, 255, 0.5) */
/* @about-chip-bg: rgba(201, 224, 255, 0.5) */

QMainWindow,
#appRoot,
#pageStack,
#contentContainer,
#datasetsPage,
#uploadPage,
#datasetsTabPages,
#pageViewport {
    background: var(--canvas);
    color: var(--ink);
}

QWidget {
    color: var(--ink);
    font-family: "Inter";
    font-size: 16px;
}

QLabel#pageTitle,
QLabel#sectionTitle,
QLabel#cardTitle,
QLabel#topbarTitle {
    color: var(--heading);
    font-family: "Plus Jakarta Sans";
    font-weight: 700;
}

QLabel#pageTitle { font-size: 32px; }
QLabel#pageSubtitle,
QLabel#pageDescription,
QLabel#cardDescription { color: var(--body); }
QLabel#pageSubtitle { font-size: 18px; }
QLabel#sectionTitle { font-size: 20px; }
QLabel#cardTitle { font-size: 18px; }
QLabel#cardDescription { font-size: 16px; }

/* Shared application frame */
QMenuBar {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #DDEAFF;
    color: #33445E;
    padding: @px(2) @px(8);
}
QMenuBar::item { background: transparent; border-radius: @px(5); padding: @px(5) @px(10); }
QMenuBar::item:selected { background: #EEF4FF; color: #0861EF; }
QMenu {
    background: #FFFFFF;
    border: 1px solid #DDEAFF;
    color: #33445E;
    padding: @px(4);
}
QMenu::item { border-radius: @px(4); padding: @px(6) @px(26) @px(6) @px(10); }
QMenu::item:selected { background: #EEF4FF; color: #0861EF; }
QMenu::separator { height: 1px; background: #E5ECF5; margin: @px(4) @px(8); }

#sidebarScroll,
#sidebar {
    background: var(--surface);
    border: none;
}
#sidebarScroll { border-right: 1px solid var(--blue-bright); }
#brandLogo {
    background: transparent;
    border: none;
    color: var(--blue);
    font-size: 34px;
    font-weight: 700;
}
#brandTitle,
#brandAccent { color: var(--blue); }
#brandTitle {
    font-family: "Plus Jakarta Sans";
    font-size: 45px;
    font-weight: 800;
}
#brandSubtitle { color: var(--body); font-size: 18px; font-weight: 600; }
#sectionLabel {
    color: var(--muted);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 3px 0 4px 50px;
}
#sidebarMenuCard { background: var(--surface); border: none; border-radius: var(--card-radius); }
#sidebarMenuCard[compact="true"] { border-radius: 0; }
#navButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--button-radius);
    min-height: 43px;
    padding: 0 12px;
    text-align: left;
}
#navButton:hover { background: var(--canvas); }
#navButton[active="true"] {
    background: var(--blue-active);
    border-color: var(--blue-active);
}
#navButton:pressed { background: var(--blue-active); }
#navButton:disabled { color: var(--muted); }
#navIcon { min-width: 30px; }
#navText { color: var(--body); font-size: 20px; }
#navButton[active="true"] #navText {
    color: var(--blue);
    font-weight: 600;
}
#workspaceStatus { background: var(--canvas); border-radius: var(--small-radius); }
#workspaceStatusTitle { color: var(--muted); font-size: 9px; font-weight: 700; }
#workspaceStatusValue { color: var(--success); font-size: 11px; }
#sidebarFooter { color: var(--muted); font-size: 9px; }

#topbar {
    background: var(--surface);
    border: none;
    border-bottom: 1px solid var(--blue-bright);
}
#topbarLink {
    background: var(--surface);
    border: 1px solid transparent;
    border-radius: var(--pill-radius);
    color: var(--body);
    min-height: 48px;
    padding: 0 10px;
    font-size: 25px;
}
#topbarLink::icon { width: 35px; height: 35px; }
#topbarLink:hover { background: var(--canvas); }
#topbarLink:pressed { background: var(--blue-active); }
#topbarLink[active="true"] {
    background: var(--blue-active);
    color: var(--blue);
}
#topbarDivider { background: var(--border-solid); }
#topbarVersion { color: var(--muted); font-size: 15px; }
#topbarVersionIcon { background: transparent; }
QScrollArea { background: var(--canvas); border: none; }
QAbstractScrollArea { background: var(--canvas); }
QAbstractScrollArea::viewport { background: var(--canvas); }
QScrollArea#datasetPreviewScroll,
QScrollArea#datasetPreviewScroll::viewport,
QWidget#datasetPreviewContainer { background: var(--canvas); border: none; }

/* Help page */
#helpPageTitle { color: var(--heading); font-size: 24px; font-weight: 700; }
#helpPageSubtitle { color: var(--muted); font-size: 14px; }
#helpHero { background: var(--blue-active); border: 1px solid var(--blue-bright); border-radius: var(--card-radius); }
#helpHeroTitle { color: var(--blue); font-size: 17px; font-weight: 700; }
#helpHeroBody, #helpBody { color: var(--body); font-size: 13px; }
#helpInfoCard { background: var(--surface); border: 1px solid var(--border); border-radius: var(--card-radius); }
#helpCardTitle { color: var(--heading); font-size: 15px; font-weight: 700; }
QPushButton#helpShortcut { background: var(--surface); border: 1px solid var(--blue-bright); border-radius: var(--button-radius); color: var(--blue); font-size: 13px; font-weight: 600; min-height: 38px; padding: 0 12px; }
QPushButton#helpShortcut:hover { background: var(--blue-active); }
QPushButton#helpShortcut:pressed { background: var(--blue-bright); color: var(--surface); }

/* Shared cards, form controls, buttons, and tables */
#contentCard,
#statCard,
#currentDatasetCard,
#quickActionCard,
#metricCard,
#researchCard,
#uploadCard,
#pipelineCard,
#pipelineStageCard,
#heroCard,
#heroVisual,
#researchStatus,
#datasetPreviewFileCard,
#datasetPreviewMetricCard,
#datasetPreviewTableCard,
#datasetPreviewColumnsCard,
#datasetSearchCard,
#datasetResultCard,
#metricCard {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--card-radius);
}

#researchSectionDivider { background: var(--border); border: none; }
#researchPaperPreviewRow { background: var(--canvas); border: 1px solid var(--border); border-radius: var(--small-radius); }
#researchPaperPreviewRank { background: var(--blue-active); border-radius: var(--pill-radius); color: var(--blue); font-size: 13px; font-weight: 700; padding: 6px; }
#researchPaperPreviewTitle { color: var(--heading); font-size: 15px; font-weight: 600; }

QPushButton#primaryButton,
QPushButton#analyzeButton,
QPushButton#runButton,
QPushButton#uploadButton {
    background: var(--blue);
    border: 1px solid var(--blue);
    border-radius: var(--button-radius);
    color: var(--surface);
    font-weight: 600;
    font-size: 18px;
    padding: 0 18px;
}
QPushButton#primaryButton:hover,
QPushButton#analyzeButton:hover,
QPushButton#runButton:hover,
QPushButton#uploadButton:hover { background: var(--blue-hover); border-color: var(--blue-hover); }
QPushButton#datasetPreviewUploadButton { background: var(--blue); border: 1px solid var(--blue); border-radius: var(--small-radius); color: var(--surface); min-height: 61px; padding: 0; }
QPushButton#datasetPreviewUploadButton:hover { background: var(--blue-hover); border-color: var(--blue-hover); }
QPushButton#datasetPreviewUploadButton:pressed { background: var(--blue); }
QPushButton#datasetPreviewUploadButton:disabled { background: var(--border-solid); border-color: var(--border-solid); }
#datasetPreviewUploadIcon { background: transparent; border: none; }
#datasetPreviewUploadText { color: var(--surface); font-size: 18px; font-weight: 600; }
QPushButton#primaryButton:pressed,
QPushButton#analyzeButton:pressed,
QPushButton#runButton:pressed,
QPushButton#uploadButton:pressed { background: var(--blue); }
QPushButton#primaryButton:disabled,
QPushButton#analyzeButton:disabled,
QPushButton#runButton:disabled,
QPushButton#uploadButton:disabled { background: var(--border-solid); border-color: var(--border-solid); color: var(--muted); }
QPushButton#primaryButton[analysisRun="true"] { border-radius: var(--small-radius); font-size: 23px; min-height: 61px; padding: 0 24px; }

QPushButton#secondaryButton,
#uploadSearchButton {
    background: var(--surface);
    border: 1px solid var(--blue-bright);
    border-radius: var(--button-radius);
    color: var(--blue);
    font-weight: 600;
    font-size: 18px;
    padding: 0 14px;
}
QPushButton#secondaryButton:hover,
#uploadSearchButton:hover { background: var(--canvas); }
QPushButton#secondaryButton:pressed,
#uploadSearchButton:pressed { background: var(--blue-active); }

QLineEdit,
QComboBox,
QTextEdit,
QTextBrowser,
QDateEdit,
QSpinBox {
    background: var(--surface);
    border: 1px solid var(--border-solid);
    border-radius: var(--small-radius);
    color: var(--ink);
    padding: 8px 12px;
    selection-background-color: var(--blue-active);
}
QLineEdit:focus,
QComboBox:focus,
QTextEdit:focus,
QTextBrowser:focus { border: 1px solid var(--blue-bright); }
QLineEdit:disabled,
QComboBox:disabled,
QTextEdit:disabled { background: var(--canvas); color: var(--muted); }
QComboBox QAbstractItemView {
    background: var(--surface);
    border: 1px solid var(--border-solid);
    selection-background-color: var(--blue-active);
}
QTabWidget::pane { border: 1px solid var(--border); border-radius: var(--small-radius); background: var(--surface); }
#datasetsTabs, #datasetsTabs::pane { background: var(--canvas); border: none; border-radius: 0; }
QTabBar::tab {
    background: transparent;
    border: none;
    color: var(--body);
    padding: 10px 14px;
}
QTabBar::tab:hover { color: var(--blue); }
QTabBar::tab:selected { color: var(--blue); border-bottom: 2px solid var(--blue); font-weight: 600; }
QTableView,
QTableWidget {
    background: var(--surface);
    alternate-background-color: var(--canvas);
    border: 1px solid var(--border-solid);
    gridline-color: var(--border-solid);
    selection-background-color: var(--blue-active);
    selection-color: var(--ink);
}
QHeaderView::section {
    background: var(--canvas);
    border: none;
    border-bottom: 1px solid var(--border-solid);
    color: var(--body);
    font-weight: 600;
    padding: 8px;
}
QScrollBar:vertical { width: 10px; background: transparent; margin: 0; }
QScrollBar::handle:vertical { background: var(--border-solid); border-radius: 5px; min-height: 28px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* Dataset: upload */
#uploadPage QLabel#pageSubtitle,
#datasetPreviewHeader QLabel#pageSubtitle { font-size: 23px; }
#uploadPageSectionTitle { color: var(--heading); font-family: "Inter"; font-size: 25px; font-weight: 700; }
#uploadDropzone { background: var(--surface); border: 2px dashed var(--blue-bright); border-radius: var(--small-radius); }
#uploadDropIcon { background: transparent; border: none; }
#uploadSearchIcon { background: var(--blue-active); border-radius: 14px; }
#uploadStepBadge { background: var(--blue-active); border-radius: 20px; color: var(--blue); font-size: 16px; font-weight: 700; }
#uploadDropTitle { color: var(--heading); font-size: 25px; font-weight: 700; }
#uploadDropDescription, #uploadDropSizeLimit { color: var(--body); font-size: 23px; }
#uploadStepDetail { color: var(--body); font-size: 16px; }
#uploadTipsText { color: var(--body); font-size: 16px; }
#uploadBrowseLink { background: transparent; border: none; color: var(--blue-bright); font-size: 23px; padding: 0; font-weight: 600; }
#uploadBrowseLink:hover { color: var(--blue); text-decoration: underline; }
#uploadStep, #uploadSearchCard, #uploadTipsCard { background: var(--surface); border: 1px solid var(--border); border-radius: var(--small-radius); }
#uploadSearchCard, #uploadTipsCard { border-radius: var(--card-radius); }
#uploadStepTitle { color: var(--heading); font-size: 20px; font-weight: 700; }
#uploadSearchCard #cardTitle, #uploadTipsCard #cardTitle { color: var(--heading); font-family: "Inter"; font-size: 20px; font-weight: 600; }
#uploadSearchCard #cardDescription { font-size: 16px; }
#uploadSearchButton { text-align: left; padding-left: 13px; }

/* Dataset Preview: keep its spreadsheet controls inside the shared DORA light theme. */
#datasetPreviewScroll, #datasetPreviewScroll::viewport, #datasetPreviewContainer { background: #F6FBFF; }
#datasetPreviewHeader { background: transparent; border: none; border-radius: 0; }
#datasetPreviewHeader QLabel#pageTitle { color: #0C1648; font-family: "Plus Jakarta Sans"; font-size: @px(30); font-weight: 700; }
#datasetPreviewHeader QLabel#pageSubtitle { color: #536391; font-family: "Inter"; font-size: @px(15); }
#datasetPreviewBreadcrumb { color: var(--muted); font-family: "Inter"; font-size: @px(12); }
QPushButton#datasetPreviewActionButton { background: #FFFFFF; border: 1px solid #E0EEFF; border-radius: @px(8); color: #24344D; font-family: "Inter"; font-size: @px(13); font-weight: 600; padding: 0 @px(10); }
QPushButton#datasetPreviewActionButton:hover { background: #F2F7FF; border-color: #9CC5FF; }
QPushButton#datasetPreviewActionButton:disabled { color: var(--muted); }
QPushButton#datasetPreviewContinueButton { background: #0060FF; border: 1px solid #0060FF; border-radius: @px(8); color: #FFFFFF; font-family: "Inter"; font-size: @px(13); font-weight: 600; padding: 0 @px(10); }
QPushButton#datasetPreviewContinueButton:hover { background: #0758D9; border-color: #0758D9; }
#datasetPreviewFileCard, #datasetPreviewMetricCard, #datasetPreviewTableCard, #datasetPreviewColumnsCard { background: #FFFFFF; border: 1px solid #E0EEFF; border-radius: @px(10); }
#datasetPreviewFileIdentity { background: transparent; border: none; }
#datasetPreviewLoadedBadge { background: #EAF8F0; border: 1px solid #C8EBD7; border-radius: @px(12); color: #16804A; font-family: "Inter"; font-size: @px(10); font-weight: 600; padding: @px(5) @px(9); }
#datasetPreviewFileName { color: var(--heading); font-family: "Inter"; font-size: @px(16); font-weight: 650; }
#datasetPreviewFileDetails { color: var(--muted); font-family: "Inter"; font-size: @px(11); }
#datasetPreviewFileIcon { background: #EEF4FF; border: none; border-radius: @px(8); }
#datasetPreviewMetricCard { border-radius: @px(9); }
#datasetPreviewMetricIcon { background: #EEF4FF; border: none; border-radius: @px(8); }
#datasetPreviewMetricTitle { color: var(--muted); font-family: "Inter"; font-size: @px(10); font-weight: 600; }
#datasetPreviewMetricValue { color: var(--heading); font-family: "Inter"; font-size: @px(22); font-weight: 700; }
#datasetPreviewMetricDescription { color: var(--muted); font-family: "Inter"; font-size: @px(10); }
#datasetPreviewTabs { background: #FFFFFF; border: 1px solid #E0EEFF; border-radius: @px(9); }
#datasetPreviewTabsScroll, #datasetPreviewTabsScroll QWidget { background: transparent; border: none; }
QPushButton#datasetPreviewTab { background: transparent; border: none; border-bottom: 2px solid transparent; border-radius: 0; color: var(--body); font-family: "Inter"; font-size: @px(12); min-height: @px(43); padding: 0 @px(13); }
QPushButton#datasetPreviewTab:hover { color: #0060FF; }
QPushButton#datasetPreviewTab[active="true"] { border-bottom: 2px solid #0060FF; color: #0060FF; font-weight: 600; }
#datasetPreviewTableCard, #datasetPreviewColumnsCard { border-radius: @px(10); }
QLabel#datasetPreviewSectionTitle { color: var(--heading); font-family: "Inter"; font-size: @px(16); font-weight: 650; }
#datasetPreviewCount, #datasetPreviewPaginationLabel { color: var(--muted); font-family: "Inter"; font-size: @px(11); }
#datasetPreviewControlLabel { color: var(--muted); font-family: "Inter"; font-size: @px(11); }
QLineEdit#datasetPreviewTableSearch, QComboBox#datasetPreviewPageSize { background: #FFFFFF; border: 1px solid #D8E6FA; border-radius: @px(6); color: #344054; font-family: "Inter"; font-size: @px(11); min-height: @px(32); padding: 0 @px(8); }
QTableView#datasetPreviewTable { background: #FFFFFF; border: none; color: #35435B; font-family: "Inter"; font-size: @px(11); gridline-color: #E0EEFF; selection-background-color: #EAF2FF; selection-color: #17243A; }
QTableView#datasetPreviewTable::item { padding-left: @px(8); padding-right: @px(4); border-bottom: 1px solid #E0EEFF; }
QTableView#datasetPreviewTable QHeaderView::section { background: #EEF4FF; border: none; border-bottom: 1px solid #E0EEFF; color: #42516A; font-family: "Inter"; font-size: @px(10); font-weight: 600; padding: @px(4) @px(8); }
QPushButton#datasetPreviewPageButton { background: transparent; border: 1px solid transparent; border-radius: @px(6); color: var(--body); font-family: "Inter"; font-size: @px(12); }
QPushButton#datasetPreviewPageButton[arrow="true"] { background: #FFFFFF; border-color: #D8E6FA; color: #0060FF; }
QPushButton#datasetPreviewPageButton[active="true"] { background: #0060FF; border-color: #0060FF; color: #FFFFFF; }
QPushButton#datasetPreviewPageButton:hover { background: #F2F7FF; border-color: #9CC5FF; color: #0060FF; }
QPushButton#datasetPreviewShowAll, QPushButton#datasetPreviewGuideButton { background: transparent; border: none; color: #0060FF; font-family: "Inter"; font-size: @px(10); font-weight: 600; padding: 0; }
#datasetPreviewColumnInfoHeader { color: var(--muted); font-family: "Inter"; font-size: @px(10); font-weight: 600; }
#datasetPreviewColumnRow { background: transparent; border: none; border-top: 1px solid #E0EEFF; }
#datasetPreviewColumnName { color: var(--heading); font-family: "Inter"; font-size: @px(11); font-weight: 600; }
#datasetPreviewColumnType { background: transparent; border: none; border-radius: 0; color: var(--body); font-family: "Inter"; font-size: @px(10); font-weight: 500; padding: 0; }
#datasetPreviewColumnType[columnType="target"] { color: #16804A; }
#datasetPreviewColumnType[columnType="categorical"] { color: #C16B00; }
#datasetPreviewColumnType[columnType="numeric"] { color: #0060FF; }
#datasetPreviewColumnInformation { color: var(--body); font-family: "Inter"; font-size: @px(10); }
#datasetPreviewColumnsScroll, #datasetPreviewColumnsScroll QWidget#datasetPreviewColumnsContent { background: #FFFFFF; border: none; }
#datasetPreviewTipsCard { background: #EAF3FF; border: 1px solid #C7DFFF; border-radius: @px(10); }
#datasetPreviewTipsTitle { color: var(--heading); font-family: "Inter"; font-size: @px(14); font-weight: 650; }
#datasetPreviewTipItem { background: var(--surface); border: 1px solid var(--border); border-radius: @px(8); }
#datasetPreviewTipIcon { background: #EEF4FF; border-radius: @px(18); }
#datasetPreviewTipHeading { color: var(--heading); font-family: "Inter"; font-size: @px(10); font-weight: 600; }
#datasetPreviewTipBody { color: var(--body); font-family: "Inter"; font-size: @px(10); }
#datasetPreviewContentStack, #datasetPreviewBody, #datasetPreviewAnalysisPage { background: transparent; border: none; }
#datasetPreviewAnalysisCard { background: #FFFFFF; border: 1px solid #E0EEFF; border-radius: @px(10); }
#datasetPreviewAnalysisDescription { color: var(--muted); font-family: "Inter"; font-size: @px(11); }
#datasetPreviewAnalysisSummary { background: #EEF4FF; border-radius: @px(7); color: #0060FF; font-family: "Inter"; font-size: @px(11); padding: @px(8) @px(10); }
QTableView#datasetPreviewAnalysisTable { background: #FFFFFF; alternate-background-color: #F6FBFF; border: 1px solid #E0EEFF; color: #344054; font-family: "Inter"; font-size: @px(10); gridline-color: #E0EEFF; selection-background-color: #EAF2FF; selection-color: #17243A; }
QTableView#datasetPreviewAnalysisTable QHeaderView::section { background: #F6FBFF; border: none; border-bottom: 1px solid #E0EEFF; color: #536391; font-family: "Inter"; font-size: @px(9); font-weight: 600; padding: @px(8) @px(9); }

QWidget#sidebar[figmaPage4="true"], QWidget#sidebar[figmaPage4="true"] QScrollArea { background: #FFFFFF; border: none; }
QWidget#sidebar[figmaPage4="true"] QLabel#brandTitle, QLabel#brandTitle[figmaPage4="true"] { color: #17243A; font-family: "Inter"; font-size: @px(24); font-weight: 700; }
QWidget#sidebar[figmaPage4="true"] QLabel#brandSubtitle, QLabel#brandSubtitle[figmaPage4="true"] { color: #8390A3; font-family: "Inter"; font-size: @px(10); }
QWidget#sidebar[figmaPage4="true"] QLabel#sectionLabel, QLabel#sectionLabel[figmaPage4="true"] { color: #8A94A3; font-family: "Inter"; font-size: @px(10); font-weight: 600; letter-spacing: @px(0.5); padding: @px(2) 0 @px(3) @px(13); }
QWidget#sidebar[figmaPage4="true"] QFrame#sidebarMenuCard, QFrame#sidebarMenuCard[figmaPage4="true"] { background: transparent; border: none; border-radius: 0; }
QWidget#sidebar[figmaPage4="true"] QPushButton#navButton, QPushButton#navButton[figmaPage4="true"] { background: transparent; border: 1px solid transparent; border-radius: @px(7); min-height: @px(28); padding: 0 @px(5); }
QWidget#sidebar[figmaPage4="true"] QPushButton#navButton:hover, QPushButton#navButton[figmaPage4="true"]:hover { background: #F5F8FD; }
QWidget#sidebar[figmaPage4="true"] QPushButton#navButton[active="true"], QPushButton#navButton[figmaPage4="true"][active="true"] { background: #EEF4FF; border-color: #EEF4FF; }
QWidget#sidebar[figmaPage4="true"] QLabel#navText, QLabel#navText[figmaPage4="true"] { color: #536174; font-family: "Inter"; font-size: @px(12); font-weight: 500; }
QWidget#sidebar[figmaPage4="true"] QPushButton#navButton[active="true"] QLabel#navText, QPushButton#navButton[figmaPage4="true"][active="true"] QLabel#navText[figmaPage4="true"] { color: #0861EF; font-weight: 600; }
QWidget#sidebar[figmaPage4="true"] QLabel#sidebarCopyrightLabel { color: #7F8DA2; font-family: "Inter"; font-size: @px(11); }
QPushButton#overviewSidebarLink[figmaPage4="true"] { background: transparent; border: none; border-radius: 0; color: #24344D; font-family: "Inter"; font-size: @px(13); font-weight: 500; padding: 0; text-align: left; }
QPushButton#overviewSidebarLink[figmaPage4="true"]:hover { background: transparent; color: #0063FF; }
QLabel#datasetPreviewPaginationEllipsis { color: #78869B; font-family: "Inter"; font-size: @px(11); }

/* Page 4 · Upload Dataset loaded state */
QScrollArea#uploadLoadedScroll, QWidget#uploadLoadedContainer { background: #F5FAFF; border: none; }
QLabel#uploadLoadedTitle { color: #0E1930; font-family: "Inter"; font-size: @px(22); font-weight: 700; }
QLabel#uploadLoadedSubtitle { color: #617393; font-family: "Inter"; font-size: @px(12); }
QPushButton#uploadLoadedGuideButton { background: #FFFFFF; border: 1px solid #C4DCFF; border-radius: @px(8); color: #0064ED; font-family: "Inter"; font-size: @px(11); font-weight: 500; min-height: @px(32); padding: 0 @px(10); }
QPushButton#uploadLoadedGuideButton:hover { background: #F2F7FF; }
QFrame#uploadLoadedFileSummary, QFrame#uploadLoadedPreviewPanel { background: #FFFFFF; border: 1px solid #E0EBFA; border-radius: @px(12); }
QLabel#uploadLoadedFileIcon { background: #0064ED; border-radius: @px(8); }
QLabel#uploadLoadedFilename { color: #17243A; font-family: "Inter"; font-size: @px(14); font-weight: 650; }
QLabel#uploadLoadedFileDetails { color: #667895; font-family: "Inter"; font-size: @px(10); }
QFrame#uploadLoadedSuccessBadge { background: #E4F8EF; border-radius: @px(7); }
QLabel#uploadLoadedSuccessIcon { background: #10B981; border-radius: @px(7); }
QLabel#uploadLoadedSuccessText { background: transparent; border: none; color: #098E55; font-family: "Inter"; font-size: @px(11); }
QPushButton#uploadLoadedReplaceButton, QPushButton#uploadLoadedDeleteButton { background: #FFFFFF; border: 1px solid #C4DCFF; border-radius: @px(7); color: #0064ED; font-family: "Inter"; font-size: @px(11); min-height: @px(31); padding: 0 @px(9); }
QPushButton#uploadLoadedReplaceButton:hover { background: #F3F8FF; }
QPushButton#uploadLoadedDeleteButton { border-color: #FFC6C6; color: #D33A3A; }
QPushButton#uploadLoadedDeleteButton:disabled { background: #FFFFFF; border-color: #FFC6C6; color: #D33A3A; }
QPushButton#uploadLoadedTab { background: transparent; border: none; border-bottom: 2px solid transparent; border-radius: 0; color: #50678A; font-family: "Inter"; font-size: @px(11); min-height: @px(32); padding: 0 @px(2); }
QPushButton#uploadLoadedTab[active="true"] { border-bottom-color: #0064ED; color: #0064ED; font-weight: 600; }
QLabel#uploadLoadedPreviewPanel QLabel { color: #617393; font-family: "Inter"; font-size: @px(11); }
QLabel#uploadLoadedRowsSummary { background: #F2F6FC; border: 1px solid #E1EAF5; border-radius: @px(7); color: #536A88; font-family: "Inter"; font-size: @px(10); min-height: @px(28); padding: 0 @px(10); }
QLabel#uploadLoadedGridHint { color: #71819A; font-family: "Inter"; font-size: @px(10); }
QTableView#uploadLoadedTable { background: #FFFFFF; alternate-background-color: #F8FBFF; border: 1px solid #CFE0F5; border-radius: @px(8); color: #20344F; font-family: "Inter"; font-size: @px(11); gridline-color: #DCE6F2; selection-background-color: #DCEAFF; selection-color: #102B52; }
QTableView#uploadLoadedTable::item { padding-left: @px(9); padding-right: @px(9); border-bottom: 1px solid #E7EEF8; }
QTableView#uploadLoadedTable QHeaderView::section { background: #F0F5FB; border: none; border-right: 1px solid #DDE7F2; border-bottom: 1px solid #DDE7F2; color: #233B5A; font-family: "Inter"; font-size: @px(11); font-weight: 600; padding: 0 @px(9); }
QTableView#uploadLoadedTable QHeaderView::section:vertical { background: #F3F7FC; color: #657892; font-weight: 500; padding: 0 @px(4); }
QTableView#uploadLoadedTable QScrollBar:horizontal { height: @px(12); background: #F5F8FC; margin: 0 @px(8); }
QTableView#uploadLoadedTable QScrollBar::handle:horizontal { background: #B9C9DE; border-radius: @px(5); min-width: @px(32); }
QTableView#uploadLoadedTable QScrollBar::add-line:horizontal, QTableView#uploadLoadedTable QScrollBar::sub-line:horizontal { width: 0; }
QTableView#uploadLoadedTable QScrollBar:vertical { width: @px(12); background: #F5F8FC; margin: @px(8) 0; }
QTableView#uploadLoadedTable QScrollBar::handle:vertical { background: #B9C9DE; border-radius: @px(5); min-height: @px(32); }
QPushButton#uploadLoadedContinueButton { background: #0064ED; border: 1px solid #0064ED; border-radius: @px(7); color: #FFFFFF; font-family: "Inter"; font-size: @px(11); font-weight: 600; min-height: @px(32); padding: 0 @px(12); }
QPushButton#uploadLoadedContinueButton:hover { background: #0758D9; border-color: #0758D9; }

/* Page 4 · Overview with no active dataset */
QScrollArea#overviewEmptyScroll, QWidget#overviewEmptyContainer { background: #F6FBFF; border: none; }
QFrame#overviewEmptyHero { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #E5F1FF, stop:1 #D3E7FF); border: none; border-radius: @px(12); }
QLabel#overviewEmptyWelcomeBadge { background: #D2E7FF; border-radius: @px(18); color: #0C1648; font-family: "Inter"; font-size: @px(14); font-weight: 700; padding: @px(7) @px(13); }
QLabel#overviewEmptyHeroTitle { color: #0C1648; font-family: "Inter"; font-size: @px(31); font-weight: 700; }
QLabel#overviewEmptyHeroText { color: #3E548D; font-family: "Inter"; font-size: @px(17); }
QPushButton#overviewEmptyPrimaryButton, QPushButton#overviewEmptySecondaryButton { border-radius: @px(7); font-family: "Inter"; font-size: @px(14); padding: 0 @px(14); }
QPushButton#overviewEmptyPrimaryButton { background: #0060FF; border: 1px solid #0060FF; color: #FFFFFF; font-weight: 700; }
QPushButton#overviewEmptyPrimaryButton:hover { background: #0758D9; border-color: #0758D9; }
QPushButton#overviewEmptySecondaryButton { background: #FFFFFF; border: 1px solid #0060FF; color: #0060FF; }
QPushButton#overviewEmptySecondaryButton:hover { background: #F2F7FF; }
QFrame#overviewEmptyDatasetPanel { background: #FFFFFF; border: 1px dashed #DBE9FF; border-radius: @px(11); }
QFrame#overviewEmptyDatasetLoadedPanel { background: #FFFFFF; border: 1px solid #DBE9FF; border-radius: @px(11); }
QWidget#overviewEmptyDatasetGuidance { background: transparent; }
QLabel#overviewEmptyDatasetTitle { color: #080F45; font-family: "Inter"; font-size: @px(21); font-weight: 700; }
QLabel#overviewEmptyDatasetText { color: #536391; font-family: "Inter"; font-size: @px(15); }
QFrame#overviewEmptyBenefits { background: #F5F9FE; border: none; border-radius: @px(11); }
QLabel#overviewEmptyBenefitsTitle { color: #080F45; font-family: "Inter"; font-size: @px(15); font-weight: 700; }
QLabel#overviewEmptyBenefitCheck { background: #08B982; border-radius: @px(8); }
QLabel#overviewEmptyBenefitText { color: #080F45; font-family: "Inter"; font-size: @px(12); }
QFrame#overviewEmptySection, QFrame#overviewEmptyFeatures, QFrame#overviewEmptyAboutCard { background: #FFFFFF; border: 1px solid #E0EEFF; border-radius: @px(12); }
QLabel#overviewEmptySectionTitle { color: #0C1648; font-family: "Inter"; font-size: @px(18); font-weight: 700; }
QLabel#overviewEmptySectionSubtitle { color: #56648C; font-family: "Inter"; font-size: @px(13); }
QFrame#overviewEmptyStepCard, QFrame#overviewEmptyFeatureCard { background: #FFFFFF; border: 1px solid #E0EEFF; border-radius: @px(9); }
QFrame#overviewEmptyStepCard[interactive="true"]:hover { background: #F7FAFF; border-color: #9CC5FF; }
QFrame#overviewEmptyStepCard[interactive="true"]:focus { border: 2px solid #5B9BFF; }
QLabel#overviewEmptyStepNumber { background: #0063FF; border-radius: @px(14); color: #FFFFFF; font-family: "Inter"; font-size: @px(14); font-weight: 700; }
QFrame#overviewEmptyStepIconTile { background: #E1FBEE; border-radius: @px(14); }
QFrame#overviewEmptyStepIconTile[step="2"] { background: #F0E5FF; }
QFrame#overviewEmptyStepIconTile[step="3"] { background: #FFF0D9; }
QFrame#overviewEmptyStepIconTile[step="4"] { background: #F2E4FF; }
QFrame#overviewEmptyStepIconTile[step="5"] { background: #FFE8EF; }
QLabel#overviewEmptyStepTitle { color: #0C1648; font-family: "Inter"; font-size: @px(14); font-weight: 700; }
QLabel#overviewEmptyStepDetail { color: #56648C; font-family: "Inter"; font-size: @px(13); }
QLabel#overviewEmptyStepArrow { background: transparent; }
QFrame#overviewEmptyFeatureIconTile { background: #E1FBEE; border-radius: @px(14); }
QFrame#overviewEmptyFeatureIconTile[kind="figma-overview-analysis.svg"] { background: #E0EDFF; }
QFrame#overviewEmptyFeatureIconTile[kind="figma-overview-ml.svg"] { background: #F2E4FF; }
QFrame#overviewEmptyFeatureIconTile[kind="figma-overview-report.svg"] { background: #FFF0D9; }
QLabel#overviewEmptyFeatureTitle { color: #0C1648; font-family: "Inter"; font-size: @px(14); font-weight: 700; }
QLabel#overviewEmptyFeatureText { color: #56648C; font-family: "Inter"; font-size: @px(13); }
QPushButton#overviewEmptyLearnMore, QPushButton#overviewEmptyAboutLink { background: transparent; border: none; color: #0063FF; font-family: "Inter"; font-size: @px(11); padding: 0; }
QPushButton#overviewEmptyLearnMore:hover, QPushButton#overviewEmptyAboutLink:hover { text-decoration: underline; }
QLabel#overviewEmptyAboutTitle { color: #0C1648; font-family: "Inter"; font-size: @px(17); font-weight: 700; }
QLabel#overviewEmptyAboutText { color: #56648C; font-family: "Inter"; font-size: @px(13); }
QFrame#overviewEmptyAboutBenefit { background: #F1FBFA; border: none; border-radius: @px(9); }
QFrame#overviewEmptyAboutBenefit[kind="orange"] { background: #FFFBF3; }
QFrame#overviewEmptyAboutBenefit[kind="purple"] { background: #F8F1FF; }
QFrame#overviewEmptyAboutBenefitIconTile { background: #E1FBEE; border-radius: @px(7); }
QFrame#overviewEmptyAboutBenefitIconTile[kind="orange"] { background: #FFF0D9; }
QFrame#overviewEmptyAboutBenefitIconTile[kind="purple"] { background: #F2E4FF; }
QLabel#overviewEmptyAboutBenefitText { color: #344778; font-family: "Inter"; font-size: @px(10); }
QLabel#overviewLoadedDatasetName { color: #263B6F; font-family: "Inter"; font-size: @px(16); font-weight: 600; }
QFrame#overviewLoadedMetric { background: #F7FAFF; border: 1px solid #E0EEFF; border-radius: @px(8); }
QLabel#overviewLoadedMetricCaption { color: #617093; font-family: "Inter"; font-size: @px(10); font-weight: 700; }
QLabel#overviewLoadedMetricValue { color: #0C1648; font-family: "Inter"; font-size: @px(16); font-weight: 700; }
QLabel#overviewEmptyLoadedStatus { color: #344778; font-family: "Inter"; font-size: @px(13); font-weight: 600; }

/* Guided analysis editor */
#editorAnalysisScroll, #editorAnalysisContent { background: var(--canvas); border: none; }
QScrollArea#editorAnalysisScroll QScrollBar:vertical { width: 0; margin: 0; }
#editorAnalysisStepsCard, #editorAnalysisCodeCard { background: #ffffff; border: 1px solid #d8e6fa; border-radius: 12px; }
#editorAnalysisPageTitle { color: #172033; font-family: "Inter"; font-size: 24px; font-weight: 700; }
#editorAnalysisPageSubtitle { color: #596b94; font-family: "Inter"; font-size: 13px; }
#editorAnalysisSectionTitle { color: #172033; font-family: "Inter"; font-size: 19px; font-weight: 700; }
#editorAnalysisMuted { color: #718096; font-family: "Inter"; font-size: 13px; }
#editorAnalysisDatasetBadge { background: var(--blue-active); border-radius: var(--pill-radius); color: var(--blue); font-size: 13px; font-weight: 600; padding: 8px 13px; }
#editorAnalysisInfoBanner { background: #eaf4ff; border: 1px solid #cfe2f8; border-radius: 8px; color: #435477; font-family: "Inter"; font-size: 12px; padding: 12px 12px; }
#editorAnalysisDatasetMenu { background: #ffffff; border: 1px solid #538fff; border-radius: 8px; color: #0055ed; font-family: "Inter"; font-size: 14px; font-weight: 600; min-height: 34px; padding: 0 12px; }
#editorAnalysisDatasetMenu::menu-indicator { subcontrol-position: right center; subcontrol-origin: padding; width: 12px; }
QPushButton#editorAnalysisNotebookButton { background: #ffffff; border: 1px solid #538fff; border-radius: 8px; color: #0055ed; font-family: "Inter"; font-size: 14px; font-weight: 600; padding: 0 5px; }
QPushButton#editorAnalysisNotebookButton:hover { background: #f3f8ff; }
#editorAnalysisStepList { background: transparent; border: none; outline: none; }
#editorAnalysisStepList::item { border-radius: 6px; color: #0c1648; min-height: 36px; padding: 6px 10px; font-family: "Inter"; font-size: 13px; }
#editorAnalysisStepList::item:hover { background: var(--canvas); }
#editorAnalysisStepList::item:selected { background: #e8f3ff; color: #0063ff; font-weight: 600; }
QPushButton#editorAnalysisStepActions { background: transparent; border: none; color: #596b94; font-family: "Inter"; font-size: 20px; min-width: 28px; min-height: 28px; padding: 0; }
QPushButton#editorAnalysisStepActions:hover { background: #f3f8ff; border-radius: 6px; }
QPushButton#editorAnalysisStepActions::menu-indicator { image: none; width: 0; }
#editorAnalysisTemplateCombo, #editorAnalysisCategoryCombo, #editorAnalysisTargetCombo { background: var(--surface); border: 1px solid var(--border); border-radius: var(--button-radius); color: var(--ink); min-height: 38px; padding: 0 10px; }
#editorAnalysisTargetCombo { min-width: 190px; }
#editorAnalysisLibraryInput { background: var(--surface); border: 1px solid var(--border); border-radius: var(--button-radius); color: var(--ink); min-height: 38px; padding: 0 10px; }
#editorAnalysisFieldLabel { color: var(--body); font-size: 14px; font-weight: 600; }
#editorAnalysisCodeChrome, #editorAnalysisCodeStatusbar { background: #111b2d; border: 1px solid #243954; }
#editorAnalysisCodeChrome { border-top-left-radius: var(--small-radius); border-top-right-radius: var(--small-radius); min-height: 26px; }
#editorAnalysisFileTab { background: #172338; border-top: 2px solid #48a5ff; color: #e8f1ff; font-family: "Intel One Mono", Consolas; font-size: 11px; font-weight: 700; padding: 2px 10px; }
#editorAnalysisChromeHint { color: #8493a8; font-size: 11px; }
QWidget#editorAnalysisLineNumberArea { background: #111b2d; }
QPlainTextEdit#editorAnalysisCodeEditor { background: #172338; border: 1px solid #243954; border-radius: var(--small-radius); color: #e8f1ff; font-family: "Intel One Mono", Consolas; font-size: 14px; padding: 12px 10px 12px 0; selection-background-color: #285b91; }
#editorAnalysisCodeStatusbar { border-bottom-left-radius: var(--small-radius); border-bottom-right-radius: var(--small-radius); min-height: 24px; }
#editorAnalysisStatusText { color: #9aa9bc; font-family: "Intel One Mono", Consolas; font-size: 11px; }
#editorAnalysisStatusLanguage { color: #c3e88d; font-family: "Intel One Mono", Consolas; font-size: 11px; font-weight: 600; }
#editorAnalysisExecutionNote { background: var(--canvas); border-radius: var(--small-radius); color: var(--muted); font-size: 13px; padding: 9px 11px; }
#editorAnalysisOutputTabs { background: var(--surface); border: 1px solid var(--border); border-radius: var(--small-radius); }
#editorAnalysisOutputTabs::pane { background: #ffffff; border: none; }
QTabWidget#editorAnalysisOutputTabs QTabBar::tab { color: #718096; font-family: "Inter"; font-size: 13px; padding: 10px 18px; }
QTabWidget#editorAnalysisOutputTabs QTabBar::tab:selected { color: #0063ff; border-bottom: 2px solid #0063ff; }
QTextBrowser#editorAnalysisOutputText { background: #f8fbff; border: 1px solid #d8e6fa; border-radius: 8px; color: #435477; font-family: "Inter"; font-size: 13px; padding: 10px; }
QPlainTextEdit#editorAnalysisOutputText { background: #f8fbff; border: none; color: var(--body); font-family: "Intel One Mono"; font-size: 13px; padding: 10px; }
QPushButton#editorAnalysisMoreActions { background: #ffffff; border: 1px solid #b5cef7; border-radius: 8px; color: #0055ed; font-family: "Inter"; font-size: 13px; font-weight: 600; padding: 0 8px; }
#editorAnalysisGraphicsScroll, #editorAnalysisGraphicsContent { background: var(--surface); border: none; }
#editorAnalysisGraphicsEmpty { color: var(--muted); font-size: 14px; min-height: 120px; }
#editorAnalysisOutputGraph { background: var(--surface); border: 1px solid var(--border); border-radius: var(--small-radius); padding: 6px; }

/* Dataset search */
#datasetSearchScroll,
#datasetSearchScroll::viewport,
#datasetSearchContainer,
#datasetSearchResults { background: var(--canvas); border: none; }
QScrollArea#datasetSearchScroll QScrollBar:vertical { width: 0; margin: 0; }
#datasetSearchCard { background: rgba(255,255,255,0.38); border: 1px solid #d8e6fa; border-radius: 14px; }
QLabel#datasetSearchTitle { color: #080f3c; font-family: "Inter"; font-size: 36px; font-weight: 700; }
QLabel#datasetSearchSubtitle { color: #596b94; font-family: "Inter"; font-size: 18px; }
QLineEdit#datasetSearchInput { background: #ffffff; border: 1px solid #b5cef7; border-radius: 10px; color: #080f3c; font-family: "Inter"; font-size: 18px; min-height: 56px; padding: 0 18px; }
QLineEdit#datasetSearchInput:focus { border: 1px solid #0060e6; }
QComboBox#datasetProviderCombo { background: #ffffff; border: 1px solid #b5cef7; border-radius: 10px; color: #080f3c; font-family: "Inter"; font-size: 18px; min-height: 56px; padding: 0 17px; }
QComboBox#datasetProviderCombo::drop-down { border: none; width: 32px; }
QPushButton#primaryButton[datasetSearch="true"] { background: #0060e6; border: 1px solid #0060e6; border-radius: 11px; color: #ffffff; font-family: "Inter"; font-size: 18px; font-weight: 600; min-height: 57px; padding: 0 18px; }
QPushButton#primaryButton[datasetSearch="true"]:hover { background: #0055d1; border-color: #0055d1; }
QLabel#datasetSupportedSourcesLabel { color: #596b94; font-family: "Inter"; font-size: 15px; }
QLabel#datasetSourceBadge { background: #f3f8ff; border: 1px solid #cbddf9; border-radius: 12px; color: #080f3c; font-family: "Inter"; font-size: 13px; min-height: 30px; padding: 0 12px; }
QLabel#datasetSearchStatus { color: #080f3c; font-family: "Inter"; font-size: 18px; font-weight: 700; }
QComboBox#datasetSearchSort { background: #ffffff; border: 1px solid #c7d9f6; border-radius: 10px; color: #080f3c; font-family: "Inter"; font-size: 12px; padding: 0 12px; }
QComboBox#datasetSearchSort::drop-down { border: none; width: 28px; }
QLabel#datasetSearchEmpty { color: #596b94; font-family: "Inter"; font-size: 14px; padding: 12px 4px; }
#datasetResultCard { background: rgba(255,255,255,0.91); border: 1px solid #d8e6fa; border-radius: 12px; }
#datasetResultTitle { color: #080f3c; font-family: "Inter"; font-size: 18px; font-weight: 700; }
#datasetResultId { color: #596b94; font-family: "Inter"; font-size: 13px; }
#datasetResultDescription { color: #303030; font-family: "Inter"; font-size: 13px; }
#datasetResultCard #scoreBadge { background: #ddfce8; border: 1px solid #ddfce8; border-radius: 10px; color: #005d37; font-family: "Inter"; font-size: 13px; font-weight: 500; padding: 0 10px; }
#datasetSearchMetadataChip { background: #f1f5fa; border: none; border-radius: 10px; }
QLabel#datasetSearchMetadataText { color: #080f3c; font-family: "Inter"; font-size: 13px; }
QLabel#datasetFilesCount { color: #080f3c; font-family: "Inter"; font-size: 12px; font-weight: 600; }
QLabel#datasetSelectedFileSize { color: #080f3c; font-family: "Inter"; font-size: 12px; }
QLabel#datasetFilesUnavailable { color: #596b94; font-family: "Inter"; font-size: 12px; }
QFrame#searchResultDivider { background: #e1eaf5; border: none; }
QComboBox#datasetFileSelect { background: #f1f5fa; border: 1px solid #e1eaf5; border-radius: 10px; color: #080f3c; font-family: "Inter"; font-size: 12px; min-height: 35px; padding: 0 10px; }
QPushButton#datasetSearchDownloadButton { background: #ffffff; border: 1px solid #e1eaf5; border-radius: 8px; padding: 0; }
QPushButton#datasetSearchDownloadButton:hover { background: #f3f8ff; }
QPushButton#datasetSearchDownloadButton:disabled { background: #f1f5fa; }
#datasetResultCard QPushButton#secondaryButton { background: #ffffff; border: 1px solid #538fff; border-radius: 8px; color: #0055ed; font-family: "Inter"; font-size: 14px; font-weight: 600; padding: 0 8px; }
QPushButton#datasetAnalyzeButton { background: #0060e6; border: 1px solid #0060f4; border-radius: 8px; color: #ffffff; font-family: "Inter"; font-size: 14px; font-weight: 600; min-height: 36px; padding: 0 8px; }
QPushButton#datasetAnalyzeButton:hover { background: #0055d1; border-color: #0055d1; }
QPushButton#datasetAnalyzeButton:pressed { background: #0060e6; }
QPushButton#datasetAnalyzeButton:disabled { background: #dbe5f2; border-color: #dbe5f2; color: #7584a8; }

/* ML Intelligence — Page 4 frame 12. */
#mlPageTitle { color: var(--heading); font-family: "Plus Jakarta Sans"; font-size: 32px; font-weight: 700; }
#mlPageDescription { color: var(--body); font-family: "Inter"; font-size: 14px; }
QPushButton#primaryButton[mlRun="true"] { min-width: 124px; min-height: 44px; }
#mlInfoCard { background: #ffffff; border: 1px solid #d8e6fa; border-radius: 10px; }
#mlMetricIconTile { background: #e9f2ff; border: none; border-radius: 10px; }
#mlMetricIconTile[kind="purple"] { background: #f4eaff; }
#mlMetricIconTile[kind="green"] { background: #e4f8ec; }
#mlMetricIconTile[kind="orange"] { background: #fff1d9; }
#mlMetricLabel { color: #64718a; font-family: "Inter"; font-size: 10px; font-weight: 600; }
#mlMetricValue { color: #172033; font-family: "Inter"; font-size: 19px; font-weight: 700; }
#mlMetricDescription { color: #718096; font-family: "Inter"; font-size: 10px; }
#mlPrimaryTaskSummary, #mlDetectionStatusCard { background: #ffffff; border: 1px solid #d8e6fa; border-radius: 12px; }
#mlSummaryEyebrow { color: #64718a; font-family: "Inter"; font-size: 12px; font-weight: 700; }
#mlSummaryTaskTitle { color: #172033; font-family: "Inter"; font-size: 18px; font-weight: 700; }
#mlSummaryTarget { color: #64718a; font-family: "Inter"; font-size: 13px; }
#mlSummaryConfidence { background: #e4f8ec; border-radius: 10px; color: #00894f; font-family: "Inter"; font-size: 11px; font-weight: 600; padding: 5px 10px; }
QProgressBar#mlSummaryConfidenceBar, QProgressBar#mlMethodScoreBar { background: #e6edf6; border: none; border-radius: 4px; max-height: 8px; min-height: 8px; }
QProgressBar#mlSummaryConfidenceBar::chunk, QProgressBar#mlMethodScoreBar::chunk { background: #1764f5; border: none; border-radius: 4px; }
QFrame#mlMethodRankingRow { background: #ffffff; border: 1px solid #d8e6fa; border-radius: 9px; }
#mlMethodRank { background: #e9f2ff; border-radius: 18px; color: #1764f5; font-family: "Inter"; font-size: 12px; font-weight: 700; min-width: 36px; min-height: 36px; }
#mlMethodName { color: #172033; font-family: "Inter"; font-size: 13px; font-weight: 700; }
#mlMethodCategory { color: #718096; font-family: "Inter"; font-size: 11px; }
#mlMethodScore { background: #e4f8ec; border-radius: 10px; color: #00894f; font-family: "Inter"; font-size: 11px; font-weight: 600; padding: 4px 9px; }
#mlDetectionStatusCard QLabel#cardLabel { color: #64718a; font-family: "Inter"; font-size: 12px; font-weight: 700; }
#mlDetectionStatusCard QLabel#statusLabel { background: #fff1d9; border-radius: 10px; color: #b45309; font-family: "Inter"; font-size: 11px; font-weight: 700; padding: 4px 9px; }
#mlDetectionStatusCard QLabel#cardDescription { color: #64718a; font-family: "Inter"; font-size: 12px; }

/* Research Landscape */
QPushButton#landscapeSearchButton { background: #0071C2; border: 1px solid rgba(0,107,184,0.5); border-radius: 15px; color: var(--surface); font-size: 25px; font-weight: 700; min-height: 66px; padding: 0 12px; }
QPushButton#landscapeSearchButton:hover { background: var(--blue-hover); border-color: var(--blue-hover); }
QPushButton#landscapeSearchButton:pressed { background: var(--blue); }
QPushButton#landscapeSearchButton:disabled { background: var(--border-solid); border-color: var(--border-solid); color: var(--muted); }
#researchLandscapePageContent QLabel#pageSubtitle { color: #564E4E; font-size: 21px; }
#landscapeStatus { color: #564E4E; font-size: 21px; font-weight: 600; }
QWidget#researchInsightsPage, QTabWidget#researchInsightsTabs, QTabWidget#researchInsightsTabs::pane, QStackedWidget#researchInsightsTabPages { background: var(--canvas); border: none; }
QScrollArea#researchLandscapePageScroll, QScrollArea#researchLandscapePageScroll::viewport, QWidget#researchLandscapePageContent { background: var(--canvas); border: none; }
QScrollArea#landscapeScroll { background: var(--canvas); border: none; }
QScrollArea#landscapeDistributionViewport { background: var(--canvas); border: none; }
QWidget#researchLandscapeContainer, QWidget#landscapeMetricsRow, QWidget#landscapeDistributionRow { background: var(--canvas); border: none; }
#landscapeMetricCard, #landscapeDistributionCard { background: var(--surface); border: 1px solid rgba(0,107,184,0.3); border-radius: 15px; }
#landscapeMetricTitle { color: #564E4E; font-family: "Plus Jakarta Sans"; font-size: 16px; font-weight: 700; }
#landscapeMetricValue { color: #000000; font-size: 36px; font-weight: 600; }
#landscapeMetricSubtitle { color: #8E8C8C; font-size: 20px; }
#landscapeDistributionTitle { color: #000000; font-family: "Plus Jakarta Sans"; font-size: 29px; font-weight: 700; }
#landscapeMethodLabel { color: #292929; font-size: 25px; }
QProgressBar#landscapeMethodBar { background: #e3efff; border: none; border-radius: 4px; max-height: 8px; min-height: 8px; }
QProgressBar#landscapeMethodBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #bcd9ff, stop:1 var(--blue)); border: none; border-radius: 4px; }
#landscapeMethodValue { background: #BDF3C4; border: none; border-radius: 12px; color: #008000; font-size: 15px; font-weight: 600; min-width: 30px; padding: 2px 8px; }
#landscapeMethodEmpty { color: var(--muted); font-size: 18px; }

/* Analysis and research surfaces */
#analysisPageScroll,
#analysisPageScroll::viewport,
#analysisPageContent,
#analysisResultScroll,
#analysisResultScroll::viewport { background: var(--canvas); border: none; }
QScrollArea#analysisResultScroll QScrollBar:vertical { width: 0; margin: 0; }
#analysisDatasetBanner { background: var(--surface); border: 1px solid var(--border); border-radius: var(--card-radius); min-height: 86px; }
#analysisDatasetName { color: var(--heading); font-family: "Plus Jakarta Sans"; font-size: 20px; font-weight: 700; }
#analysisDatasetMetrics { color: var(--body); font-size: 22px; }
#analysisSubtitle { color: var(--body); font-size: 23px; }
#analysisOverview { background: transparent; border: none; }
#analysisFingerprintCard, #analysisQualitySummaryCard { background: var(--surface); border: 1px solid var(--border); border-radius: var(--card-radius); }
#analysisPanelTitle { color: var(--heading); font-family: "Plus Jakarta Sans"; font-size: 24px; font-weight: 700; }
#analysisPanelSubtitle { color: var(--muted); font-size: 22px; }
#analysisFingerprintValue { background: var(--fingerprint-surface); border: none; border-radius: var(--small-radius); color: var(--body); font-family: "Intel One Mono"; font-size: 16px; padding: 12px; }
#analysisQualityCritical { background: var(--quality-critical); border: none; border-radius: var(--small-radius); }
#analysisQualityWarning { background: var(--quality-warning); border: none; border-radius: var(--small-radius); }
#analysisQualityGood { background: var(--quality-good); border: none; border-radius: var(--small-radius); }
#analysisVisualizationTitle { color: var(--heading); font-family: "Plus Jakarta Sans"; font-size: 24px; font-weight: 700; }
#analysisControlLabel { color: var(--body); font-size: 18px; }
QComboBox#analysisControlSelect { background: var(--surface); border: 1px solid var(--border); border-radius: var(--card-radius); color: var(--ink); font-size: 20px; min-height: 65px; padding: 0 18px; }
QComboBox#analysisControlSelect:focus { border: 1px solid var(--blue-bright); }
QComboBox#analysisControlSelect QAbstractItemView { background: var(--surface); selection-background-color: var(--blue-active); }
#analysisChartMessage { color: var(--muted); font-size: 18px; }
#readinessTitle { color: var(--heading); font-size: 14px; font-weight: 700; }
#readinessMetric { background: var(--canvas); border: 1px solid var(--blue-active); border-radius: var(--small-radius); }
#readinessMetricValue { color: var(--ink); font-size: 14px; font-weight: 700; }
#readinessMetricLabel, #readinessRecommendation, #statusLabel { color: var(--muted); }
#readinessStatus { border-radius: var(--small-radius); padding: 5px 9px; }
#chartCanvas { background: var(--surface); }
#metricTitle { color: var(--body); font-size: 9px; font-weight: 700; }
#metricValue { color: var(--heading); font-size: 20px; font-weight: 700; }

/* Dialogs */
QDialog { background: var(--surface); border-radius: var(--dialog-radius); }
QDialog#uploadDatasetDialog { background: transparent; border: none; border-radius: var(--dialog-radius); }
#uploadDialogSurface { background: var(--surface); border: none; border-radius: var(--dialog-radius); }
QScrollArea#uploadDialogContent,
QScrollArea#uploadDialogContent::viewport,
#uploadDialogViewport,
#uploadDialogContentBody { background: transparent; border: none; }
#dialogOverlay { background: var(--overlay); border: none; }
#uploadDialogTitle { color: var(--heading); font-family: "Plus Jakarta Sans"; font-size: 36px; font-weight: 700; }
#uploadDialogSubtitle { color: var(--body); font-size: 28px; }
#uploadDialogFileCard { background: var(--canvas); border: 1px solid var(--blue-bright); border-radius: var(--dialog-radius); }
#uploadDialogFileIcon { background: var(--blue-active); border-radius: 16px; }
#uploadDialogFileName { color: var(--heading); font-size: 30px; font-weight: 700; }
#uploadDialogFileDetails { color: var(--body); font-size: 24px; }
#uploadDialogLabel { color: var(--muted); font-size: 20px; font-weight: 600; }
QLineEdit#uploadDialogInput,
QComboBox#uploadDialogInput {
    background: var(--surface);
    border: 1px solid var(--blue-bright);
    border-radius: var(--dialog-radius);
    color: var(--ink);
    font-size: 26px;
    min-height: 61px;
    padding: 0 24px;
}
QLineEdit#uploadDialogInput:focus,
QComboBox#uploadDialogInput:focus { border: 1px solid var(--blue); }
QCheckBox#uploadDialogCheck { color: var(--ink); font-size: 28px; spacing: 12px; }
QCheckBox#uploadDialogCheck::indicator { width: 60px; height: 30px; border: 1px solid var(--border-solid); border-radius: 15px; background: var(--switch-off); }
QCheckBox#uploadDialogCheck::indicator:checked { background: var(--blue-bright); border-color: var(--blue-bright); }
QDialog#uploadDatasetDialog QPushButton#primaryButton { font-size: 24px; min-height: 61px; }
QPushButton#uploadDialogCancel {
    background: var(--surface);
    border: 1px solid var(--blue-bright);
    border-radius: var(--button-radius);
    color: var(--blue);
    font-size: 26px;
    font-weight: 600;
    min-height: 61px;
}
QDialog#uploadDatasetDialog QPushButton#uploadDialogCancel { color: var(--blue); font-size: 18px; }
QPushButton#uploadDialogCancel:hover { background: var(--canvas); }
QPushButton#uploadDialogCancel:pressed { background: var(--blue-active); }
QDialog#uploadDatasetDialog[compact="true"] #uploadDialogTitle { font-size: 24px; }
QDialog#uploadDatasetDialog[compact="true"] #uploadDialogSubtitle { font-size: 16px; }
QDialog#uploadDatasetDialog[compact="true"] #uploadDialogFileName { font-size: 19px; }
QDialog#uploadDatasetDialog[compact="true"] #uploadDialogFileDetails { font-size: 14px; }
QDialog#uploadDatasetDialog[compact="true"] #uploadDialogLabel { font-size: 13px; }
QDialog#uploadDatasetDialog[compact="true"] QLineEdit#uploadDialogInput,
QDialog#uploadDatasetDialog[compact="true"] QComboBox#uploadDialogInput {
    font-size: 16px;
    min-height: 52px;
    padding: 0 16px;
}
QDialog#uploadDatasetDialog[compact="true"] QCheckBox#uploadDialogCheck { font-size: 14px; }
QDialog#uploadDatasetDialog[compact="true"] QCheckBox#uploadDialogCheck::indicator {
    width: 46px;
    height: 24px;
}
QDialog#uploadDatasetDialog[compact="true"] QPushButton#primaryButton {
    font-size: 14px;
    min-height: 52px;
}
QDialog#uploadDatasetDialog[compact="true"] QPushButton#uploadDialogCancel {
    font-size: 14px;
    min-height: 52px;
}

/* Overview frame */
QFrame#topbar[overviewMode="true"] { border-bottom: none; }
QFrame#overviewTopbarFrame { background: #ffffff; border: 1px solid #006bb8; }
QScrollArea#overviewScroll,
QScrollArea#overviewScroll::viewport,
QWidget#overviewCanvas { background: var(--canvas); border: none; }
QLabel#overviewTitle {
    color: #000000;
    font-family: "Plus Jakarta Sans";
    font-size: 32px;
    font-weight: 800;
}
QLabel#overviewSubtitle { color: #564e4e; font-size: 21px; }
QPushButton#overviewReportButton {
    background: var(--blue);
    border: 1px solid var(--blue);
