/* Notebook-style plot area uses the same font and palette as the UI. */

/* Page 4 — Dataset Analysis (Figma node 309:6185). */
QScrollArea#analysisPageScroll,
QScrollArea#analysisPageScroll::viewport,
QWidget#analysisPageContent,
QScrollArea#analysisResultScroll,
QScrollArea#analysisResultScroll::viewport {
    background: #F5F9FF;
    border: none;
}
QLabel#analysisPageTitle {
    color: #172235;
    font-family: "Inter";
    font-size: @px(32);
    font-weight: 700;
}
QLabel#analysisSubtitle { color: #75808F; font-size: @px(16); }
QPushButton#primaryButton[analysisRun="true"] {
    background: #0861EF;
    border: 1px solid #0861EF;
    border-radius: @px(10);
    color: #FFFFFF;
    font-family: "Inter";
    font-size: @px(16);
