}
QPushButton#overviewReportButton:hover { background: var(--blue-hover); border-color: var(--blue-hover); }
QPushButton#overviewReportButton:pressed { background: #005a9c; border-color: #005a9c; }
QPushButton#overviewReportButton:disabled { background: #a8c8e0; border-color: #a8c8e0; color: #ffffff; }
QFrame#overviewKeyFindings {
