}
QFrame#overviewDatasetMetric { background: var(--overview-blue-soft); border: none; border-radius: 8px; }
QLabel#overviewMetricTitle { color: #5f5f5f; font-size: 11px; font-weight: 700; }
QLabel#overviewMetricValue { color: #111111; font-size: 17px; font-weight: 700; }
QLabel#overviewSmallHeading { color: #5f5f5f; font-size: 12px; font-weight: 700; }
QWidget#overviewColumnTypeBar { background: #e3efff; border: none; border-radius: 4px; }
QFrame#overviewColumnTypeSegment[kind="id"] { background: #969696; border: none; }
QFrame#overviewColumnTypeSegment[kind="target"] { background: #14be5c; border: none; }
QFrame#overviewColumnTypeSegment[kind="numeric"] { background: #0878c8; border: none; }
QFrame#overviewColumnTypeSegment[kind="categorical"] { background: #e0b300; border: none; }
QFrame#overviewColumnTypeSegment[kind="text"] { background: #c3c3c3; border: none; }
QLabel#overviewColumnLegend { color: #5f5f5f; font-size: 10px; }
QLabel#overviewColumnLegend[kind="target"] { color: #008000; }
QLabel#overviewColumnLegend[kind="numeric"] { color: #006bb8; }
QLabel#overviewColumnLegend[kind="categorical"] { color: #8e6f00; }
QPushButton#overviewDetailsButton {
    background: transparent;
    border: none;
    color: var(--blue);
    font-size: 12px;
    font-weight: 700;
    padding: 0;
    text-align: left;
}
QPushButton#overviewDetailsButton:hover { color: var(--blue-hover); text-decoration: underline; }
QPushButton#overviewDetailsButton:pressed { color: #005a9c; }
QLabel#overviewReadinessBadge {
    background: #ffe171;
    border: none;
    border-radius: 12px;
    color: #806600;
    font-size: 14px;
    font-weight: 600;
    padding: 3px 9px;
}
QLabel#overviewGapBadge {
    background: #cde8ff;
    border: none;
    border-radius: 12px;
    color: #006bb8;
    font-size: 14px;
    font-weight: 600;
    padding: 3px 9px;
}
QLabel#overviewQualityLine { color: #564e4e; font-size: 18px; }
QLabel#overviewMostMissing { color: #564e4e; font-size: 14px; }
QLabel#overviewMLTaskBadge,
QLabel#overviewConfidenceBadge,
QLabel#overviewTargetBadge {
    border: none;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 600;
    padding: 3px 8px;
}
QLabel#overviewMLTaskBadge { background: #cde8ff; color: #006bb8; }
QLabel#overviewConfidenceBadge { background: #bdffc8; color: #008000; }
QLabel#overviewTargetBadge { background: #e6e6e6; color: #564e4e; }
QLabel#overviewModelName { color: #564e4e; font-size: 17px; }
QLabel#overviewModelValue { color: #111111; font-size: 12px; font-weight: 600; }
QProgressBar#overviewModelProgress {
    background: #e3efff;
    border: none;
    border-radius: 4px;
    max-height: 8px;
    min-height: 8px;
}
QProgressBar#overviewModelProgress::chunk { background: var(--blue); border: none; border-radius: 4px; }
QWidget#overviewSidebarFooter { background: transparent; border: none; }
QPushButton#overviewSidebarLink {
    background: rgba(255, 255, 255, 0.45);
    border: none;
    border-radius: 12px;
    color: #303030;
    font-size: 17px;
    font-weight: 600;
    padding: 0 10px;
    text-align: left;
}
QPushButton#overviewSidebarLink[compact="true"] { padding: 0; border-radius: 12px; }
QPushButton#overviewSidebarLink:hover { background: #eaf3ff; color: var(--blue); }
QPushButton#overviewSidebarLink:pressed { background: var(--blue-active); }
QPushButton#overviewSidebarLink[active="true"] { background: #ffffff; color: #303030; }
QPushButton#overviewSidebarLink[active="true"]:hover { background: #eaf3ff; color: var(--blue); }

