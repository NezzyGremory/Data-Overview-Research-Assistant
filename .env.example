APP_NAME=Dataset Research
APP_ENV=development
LOG_LEVEL=INFO

# Google Gemini API Key (bisa satu atau beberapa key dipisahkan koma untuk rotasi otomatis)
GEMINI_API_KEY=

# Optional academic-search providers. Scopus requires an Elsevier API key and
# access entitlement from Elsevier; Semantic Scholar works without a key but
# a registered key can improve rate limits.
SEMANTIC_SCHOLAR_API_KEY=
ELSEVIER_API_KEY=

# Optional usage telemetry. Leave blank to disable event transmission.
# Point to the FastAPI backend, never directly to MySQL.
TELEMETRY_API_URL=
# Optional shared secret for a managed API deployment (never hard-code in source).
TELEMETRY_API_TOKEN=
