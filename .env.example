APP_NAME=Dataset Research
APP_ENV=development
LOG_LEVEL=INFO

# Google Gemini API Key (bisa satu atau beberapa key dipisahkan koma untuk rotasi otomatis)
GEMINI_API_KEY=

# Optional academic-search providers. Scopus requires an Elsevier API key and
# access entitlement from Elsevier; Semantic Scholar works without a key but
# a registered key can improve rate limits.
SEMANTIC_SCHOLAR_API_KEY=
ELSEVIER_API_KEY=

